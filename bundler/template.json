\n  @keyframes floatY{0%,100%{transform:translateY(0);}50%{transform:translateY(-16px);}}\n  @keyframes popIn{from{opacity:0;transform:translateX(-50%) translateY(10px) scale(.94);}to{opacity:1;transform:translateX(-50%) translateY(0) scale(1);}}\n\n  /* ---------- RESPONSIVE ---------- */\n  @media (max-width: 920px){\n    nav{ padding:14px 20px !important; }\n    [data-nav-links], [data-nav-cta]{ display:none !important; }\n    [data-burger]{ display:flex !important; }\n  }\n  @media (max-width: 980px){\n    [data-hero-grid],[data-about-grid],[data-card-grid],[data-dash-grid],[data-contact-grid],\n    [data-mv-grid],[data-services-grid],[data-products-grid],[data-suggest-grid],[data-andy-grid],\n    [data-blog-grid],[data-blogcards-grid]{ grid-template-columns:1fr !important; gap:40px !important; }\n    [data-stats-grid],[data-leaders-grid],[data-affil-grid],[data-pillars-grid],\n    [data-steps-grid],[data-coop-groups],[data-ilo-grid]{ grid-template-columns:repeat(2,1fr) !important; }\n    [data-product-tabs]{ position:static !important; top:auto !important; flex-direction:row !important; flex-wrap:wrap !important; }\n  }\n  @media (max-width: 640px){\n    section{ padding:72px 22px !important; }\n    header{ padding:118px 22px 64px !important; }\n    footer{ padding:56px 22px 32px !important; }\n    h1{ font-size:42px !important; letter-spacing:-1.5px !important; }\n    h2{ font-size:31px !important; letter-spacing:-1px !important; }\n    [data-route-title]{ font-size:38px !important; }\n    [data-stats-grid]{ grid-template-columns:repeat(2,1fr) !important; }\n    [data-leaders-grid]{ grid-template-columns:repeat(2,1fr) !important; }\n    [data-affil-grid],[data-pillars-grid],[data-steps-grid],[data-coop-groups],\n    [data-ilo-grid],[data-footer-grid],[data-form2]{ grid-template-columns:1fr !important; }\n    [data-footer-grid]{ gap:28px !important; }\n    [data-mv-grid]{ grid-template-columns:1fr !important; }\n  }\n</style>\n</helmet>\n<div ref=\"{{ rootRef }}\" style=\"font-family:Urbanist,system-ui,sans-serif;color:#0A1F18;background:#FFFFFF;-webkit-font-smoothing:antialiased;\" data-screen-label=\"TMO Homepage\">\n\n  <!-- ================= NAV ================= -->\n  <nav ref=\"{{ navRef }}\" style=\"position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px 40px;background:rgba(10,31,24,0.82);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:box-shadow .3s ease;\">\n    <div sc-camel-on-click=\"{{ goHome }}\" style=\"display:flex;align-items:center;gap:12px;cursor:pointer;flex-shrink:0;\">\n      <img src=\"820573a8-f9db-4517-911c-b3d75a01cb1c\" alt=\"CMS T&amp;M\" style=\"height:42px;width:auto;display:block;\">\n    </div>\n    <div style=\"display:flex;align-items:center;gap:4px;\" data-nav-links=\"\">\n      <button sc-camel-on-click=\"{{ goHome }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navHome }};padding:10px 14px;\">Home</button>\n      <div sc-camel-on-mouse-enter=\"{{ openProducts }}\" sc-camel-on-mouse-leave=\"{{ closeProducts }}\" style=\"position:relative;\">\n        <button sc-camel-on-click=\"{{ goProducts }}\" style=\"display:flex;align-items:center;gap:6px;background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navProducts }};padding:10px 14px;\">Products\n          <span style=\"display:inline-block;width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-2px) rotate(45deg);\"></span>\n        </button>\n        <sc-if value=\"{{ productsOpen }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"position:absolute;top:100%;left:0;padding-top:12px;width:300px;\">\n          <div style=\"background:#FFFFFF;border-radius:18px;box-shadow:0 24px 60px -12px rgba(10,31,24,0.4);padding:10px;display:flex;flex-direction:column;gap:2px;\">\n            <sc-for list=\"{{ productMenu }}\" as=\"p\" hint-placeholder-count=\"4\">\n              <button sc-camel-on-click=\"{{ p.go }}\" style=\"display:flex;align-items:center;gap:14px;text-align:left;background:transparent;border:none;cursor:pointer;padding:12px 12px;border-radius:12px;\" style-hover=\"background:#F5E6C8;\">\n                <span style=\"width:38px;height:38px;flex-shrink:0;border-radius:11px;background:{{ p.bg }};display:flex;align-items:center;justify-content:center;color:{{ p.fg }};font-weight:700;font-family:MuseoModerno;font-size:15px;\">{{ p.mark }}</span>\n                <span style=\"display:flex;flex-direction:column;\">\n                  <span style=\"font-family:MuseoModerno;font-weight:700;font-size:15px;color:#0A1F18;\">{{ p.name }}</span>\n                  <span style=\"font-family:Urbanist;font-size:12.5px;color:#5B6B63;\">{{ p.tag }}</span>\n                </span>\n              </button>\n            </sc-for>\n          </div>\n          </div>\n        </sc-if>\n      </div>\n      <button sc-camel-on-click=\"{{ goAbout }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navAbout }};padding:10px 14px;\">About</button>\n      <button sc-camel-on-click=\"{{ goRoutes }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navRoutes }};padding:10px 14px;\">Routes</button>\n      <button sc-camel-on-click=\"{{ goLeadership }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navLeadership }};padding:10px 14px;\">Leadership</button>\n      <button sc-camel-on-click=\"{{ goBlog }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:{{ navBlog }};padding:10px 14px;\">Blog</button>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:10px;flex-shrink:0;\" data-nav-cta=\"\">\n      <button sc-camel-on-click=\"{{ goCard }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:14px;color:#0A1F18;padding:11px 18px;border-radius:11px;\" style-hover=\"background:#ffce4d;\">Apply for Card</button>\n      <button sc-camel-on-click=\"{{ openDriver }}\" style=\"background:transparent;border:1.5px solid rgba(255,255,255,0.35);cursor:pointer;font-family:Urbanist;font-weight:600;font-size:14px;color:#FFFFFF;padding:10px 16px;border-radius:11px;\" style-hover=\"border-color:#3CB371;\">Drive for TMO&nbsp;X</button>\n      <button sc-camel-on-click=\"{{ openLogin }}\" style=\"background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:14px;color:rgba(255,255,255,0.7);padding:10px 8px;\">Login</button>\n    </div>\n    <button sc-camel-on-click=\"{{ toggleMobile }}\" data-burger=\"\" style=\"display:none;background:transparent;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:6px;\">\n      <span style=\"display:block;width:24px;height:2px;background:#fff;\"></span>\n      <span style=\"display:block;width:24px;height:2px;background:#fff;\"></span>\n      <span style=\"display:block;width:24px;height:2px;background:#fff;\"></span>\n    </button>\n  </nav>\n\n  <!-- mobile menu -->\n  <sc-if value=\"{{ mobileMenu }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;z-index:99;background:rgba(10,31,24,0.98);backdrop-filter:blur(8px);display:flex;flex-direction:column;gap:6px;padding:90px 28px 28px;\">\n      <button sc-camel-on-click=\"{{ goHome }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">Home</button>\n      <button sc-camel-on-click=\"{{ goProducts }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">TMO Platform</button>\n      <button sc-camel-on-click=\"{{ goRoutes }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">Routes</button>\n      <button sc-camel-on-click=\"{{ goLeadership }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">Leadership</button>\n      <button sc-camel-on-click=\"{{ goAbout }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">About</button>\n      <button sc-camel-on-click=\"{{ goBlog }}\" style=\"text-align:left;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.08);font-family:MuseoModerno;font-weight:600;font-size:24px;color:#fff;padding:16px 0;\">Blog</button>\n      <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:24px;\">\n        <button sc-camel-on-click=\"{{ goCard }}\" style=\"background:#FBC02D;border:none;font-family:Urbanist;font-weight:700;font-size:17px;color:#0A1F18;padding:16px;border-radius:14px;\">Apply for Card</button>\n        <button sc-camel-on-click=\"{{ openDriver }}\" style=\"background:transparent;border:1.5px solid rgba(255,255,255,0.35);font-family:Urbanist;font-weight:600;font-size:17px;color:#fff;padding:15px;border-radius:14px;\">Drive for TMO X</button>\n        <button sc-camel-on-click=\"{{ openLogin }}\" style=\"background:transparent;border:none;font-family:Urbanist;font-weight:600;font-size:16px;color:rgba(255,255,255,0.7);padding:8px;\">Login / Register</button>\n      </div>\n    </div>\n  </sc-if