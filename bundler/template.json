splay:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.08);text-decoration:none;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M20.52 3.48A11.9 11.9 0 0 0 12.06 0C5.5 0 .17 5.33.17 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.32-1.66a11.86 11.86 0 0 0 5.73 1.46h.01c6.56 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.43-8.43Zm-8.46 18.3h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.75.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.52-5.26c0-5.46 4.45-9.91 9.92-9.91 2.65 0 5.14 1.03 7.01 2.91a9.84 9.84 0 0 1 2.9 7c0 5.47-4.45 9.92-9.9 9.92Zm5.44-7.41c-.3-.15-1.78-.88-2.06-.98-.28-.11-.48-.15-.69.15-.2.3-.79.98-.96 1.18-.18.21-.35.23-.65.08-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.5-1.79-1.67-2.09-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.69-1.66-.95-2.28-.25-.6-.5-.51-.69-.52h-.59c-.2 0-.53.08-.8.38-.28.3-1.06 1.03-1.06 2.5 0 1.48 1.08 2.9 1.23 3.1.15.2 2.12 3.24 5.13 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.71.25-1.31.18-1.43-.08-.13-.28-.21-.58-.36Z\" fill=\"#FFFFFF\"></path>\n              </svg>\n            </a>\n          </div>\n        </div>\n      </div>\n  </section>\n\n  </sc-if>\n\n  <!-- ================= FOOTER ================= -->\n  <footer style=\"background:#0A1F18;padding:72px 40px 36px;\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr 1.2fr;gap:36px;\" data-footer-grid=\"\">\n      <div>\n        <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:14px;\"><img src=\"820573a8-f9db-4517-911c-b3d75a01cb1c\" alt=\"CMS T&amp;M\" style=\"height:40px;width:auto;display:block;\"></div>\n        <p style=\"font-family:Urbanist;font-size:14px;line-height:1.6;color:rgba(255,255,255,0.55);margin:0;max-width:240px;\">Operator of the Lekki–Ajah Corridor. Powered by 58 years of Lagos transport heritage.</p>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:10px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#7FE0AC;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;\">Products</span>\n        <sc-for list=\"{{ footProducts }}\" as=\"f\" hint-placeholder-count=\"4\"><span sc-camel-on-click=\"{{ f.go }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">{{ f.label }}</span></sc-for>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:10px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#7FE0AC;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;\">Company</span>\n        <span sc-camel-on-click=\"{{ goAbout }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">About</span>\n        <span sc-camel-on-click=\"{{ goLeadership }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Leadership</span>\n        <span sc-camel-on-click=\"{{ goBlog }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Blog</span>\n        <span sc-camel-on-click=\"{{ goAbout }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">      </div>\n      <div style=\"display:flex;flex-direction:column;gap:10px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#7FE0AC;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;\">Support</span>\n        <span sc-camel-on-click=\"{{ goContact }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Contact</span>\n        <span sc-camel-on-click=\"{{ goRoutes }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Routes</span>\n        <span sc-camel-on-click=\"{{ goCard }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Apply for Card</span>\n        <span sc-camel-on-click=\"{{ openDriver }}\" style=\"font-family:Urbanist;font-size:14.5px;color:rgba(255,255,255,0.65);cursor:pointer;\" style-hover=\"color:#fff;\">Driver Registration</span>\n      </div>\n      <div>\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#7FE0AC;text-transform:uppercase;letter-spacing:1px;\">Powered by</span>\n        <div style=\"margin-top:14px;\">\n          <a href=\"https://www.treepz.com/\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;\" aria-label=\"Visit treepz website\"><img src=\"1c78ab4d-94d9-4159-99c0-9b82bd6b23d9\" alt=\"treepz\" style=\"height:30px;width:auto;display:block;\"></a>\n          <p style=\"font-family:Urbanist;font-size:13px;line-height:1.55;color:rgba(255,255,255,0.6);margin:12px 0 0;max-width:240px;\">Powered by <strong style=\"color:#fff;font-weight:700;\">Treepz</strong> in partnership with <strong style=\"color:#fff;font-weight:700;\">CMS&nbsp;T&amp;M</strong>.</p>\n        </div>\n        <div style=\"display:flex;gap:8px;margin-top:18px;align-items:center;\">\n          <span style=\"width:14px;height:14px;border-radius:3px;background:rgba(255,255,255,0.18);\"></span>\n          <span style=\"font-family:Urbanist;font-size:11px;color:rgba(255,255,255,0.4);letter-spacing:1px;\">BRTAN · LAMATA · NURTW</span>\n        </div>\n      </div>\n    </div>\n    <div style=\"max-width:1200px;margin:48px auto 0;padding-top:24px;border-top:1px solid rgba(255,255,255,0.08);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;\">\n      <span style=\"font-family:Urbanist;font-size:13px;color:rgba(255,255,255,0.45);\">© 2026 CMS&nbsp;T&amp;M. All Rights Reserved.</span>\n      <span style=\"font-family:Urbanist;font-size:13px;color:rgba(255,255,255,0.45);cursor:pointer;\">Privacy Policy</span>\n    </div>\n  </footer>\n\n  <!-- ================= MODALS ================= -->\n  <sc-if value=\"{{ modalOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div sc-camel-on-click=\"{{ closeModal }}\" style=\"position:fixed;inset:0;z-index:200;background:rgba(10,31,24,0.62);backdrop-filter:blur(6px);display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto;\" data-screen-label=\"Modal\">\n      <div sc-camel-on-click=\"{{ stop }}\" style=\"width:100%;max-width:560px;background:#fff;border-radius:26px;box-shadow:0 50px 100px -30px rgba(0,0,0,0.6);overflow:hidden;margin:auto;\">\n\n        <!-- DRIVER ONBOARDING -->\n        <sc-if value=\"{{ modalDriver }}\" hint-placeholder-val=\"{{ false }}\">\n          <div>\n            <div style=\"background:#0A1F18;padding:28px 32px;position:relative;\">\n              <button sc-camel-on-click=\"{{ closeModal }}\" style=\"position:absolute;top:22px;right:24px;background:rgba(255,255,255,0.1);border:none;cursor:pointer;width:34px;height:34px;border-radius:50%;color:#fff;font-size:18px;\">×</button>\n              <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">TMO X Driver Onboarding</span>\n              <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:26px;color:#fff;margin:8px 0 18px;\">Start earning on your route</h3>\n              <div style=\"display:flex;gap:8px;\">\n                <sc-for list=\"{{ driverProgress }}\" as=\"p\" hint-placeholder-count=\"4\">\n                  <div style=\"flex:1;height:6px;border-radius:4px;background:{{ p.color }};\"></div>\n                </sc-for>\n              </div>\n              <span style=\"font-family:Urbanist;font-size:12.5px;color:rgba(255,255,255,0.55);margin-top:10px;display:block;\">Step {{ driverStep }} of 4 · {{ driverStepName }}</span>\n            </div>\n\n            <sc-if value=\"{{ driverDone }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:46px 36px;text-align:center;\">\n                <div style=\"width:74px;height:74px;border-radius:50%;background:#3CB371;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;font-size:36px;\">✓</div>\n                <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:26px;color:#0F4C3A;margin:0 0 12px;\">You're in the queue! 🚗</h3>\n                <p style=\"font-family:Urbanist;font-size:16px;line-height:1.6;color:#41514A;margin:0 0 26px;\">Verification takes up to 48 hours. We'll text you the moment your route goes live. Oya, get ready to earn.</p>\n                <button sc-camel-on-click=\"{{ closeModal }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#0A1F18;padding:14px 28px;border-radius:12px;\">Done</button>\n              </div>\n            </sc-if>\n\n            <sc-if value=\"{{ driverFormOpen }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"padding:30px 32px 32px;\">\n                <!-- STEP 1 -->\n                <sc-if value=\"{{ ds1 }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"display:flex;flex-direction:column;gap:16px;\">\n                    <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Full Name</span><input value=\"{{ driver.name }}\" sc-camel-on-input=\"{{ h.driver.name }}\" placeholder=\"e.g. Emeka Adeyemi\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.name }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.name }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.name }}</span></sc-if></label>\n                    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Phone</span><input value=\"{{ driver.phone }}\" sc-camel-on-input=\"{{ h.driver.phone }}\" placeholder=\"0913…\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.phone }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.phone }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.phone }}</span></sc-if></label>\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Email</span><input value=\"{{ driver.email }}\" sc-camel-on-input=\"{{ h.driver.email }}\" placeholder=\"you@email.com\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.email }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.email }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.email }}</span></sc-if></label>\n                    </div>\n                  </div>\n                </sc-if>\n                <!-- STEP 2 -->\n                <sc-if value=\"{{ ds2 }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"display:flex;flex-direction:column;gap:16px;\">\n                    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Vehicle Make</span><input value=\"{{ driver.make }}\" sc-camel-on-input=\"{{ h.driver.make }}\" placeholder=\"Toyota\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.make }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.make }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.make }}</span></sc-if></label>\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Model</span><input value=\"{{ driver.model }}\" sc-camel-on-input=\"{{ h.driver.model }}\" placeholder=\"Corolla\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.model }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.model }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.model }}</span></sc-if></label>\n                    </div>\n                    <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;\">\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Year</span><input value=\"{{ driver.year }}\" sc-camel-on-input=\"{{ h.driver.year }}\" placeholder=\"2018\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.year }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.year }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.year }}</span></sc-if></label>\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Colour</span><input value=\"{{ driver.color }}\" sc-camel-on-input=\"{{ h.driver.color }}\" placeholder=\"Silver\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.color }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.color }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.color }}</span></sc-if></label>\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Seats</span><sc-raw-select value=\"{{ driver.seats }}\" sc-camel-on-change=\"{{ h.driver.seats }}\" style=\"font-family:Urbanist;font-size:15px;padding:13px 12px;border:1.5px solid {{ driverBorder.seats }};border-radius:11px;outline:none;background:#fff;\"><option value=\"\">—</option><option value=\"1\">1</option><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option></sc-raw-select><sc-if value=\"{{ driverErr.seats }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.seats }}</span></sc-if></label>\n                    </div>\n                    <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Plate Number</span><input value=\"{{ driver.plate }}\" sc-camel-on-input=\"{{ h.driver.plate }}\" placeholder=\"LND 482 KJ\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ driverBorder.plate }};border-radius:11px;outline:none;text-transform:uppercase;\"><sc-if value=\"{{ driverErr.plate }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.plate }}</span></sc-if></label>\n                  </div>\n                </sc-if>\n                <!-- STEP 3 -->\n                <sc-if value=\"{{ ds3 }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"display:flex;flex-direction:column;gap:16px;\">\n                    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">From</span><sc-raw-select value=\"{{ driver.from }}\" sc-camel-on-change=\"{{ h.driver.from }}\" style=\"font-family:Urbanist;font-size:15px;padding:13px 12px;border:1.5px solid {{ driverBorder.from }};border-radius:11px;outline:none;background:#fff;\"><option value=\"\">Start stop…</option><option>Ajah</option><option>Sangotedo</option><option>Chevron/Jakande</option><option>Lekki Phase 1</option><option>Victoria Island</option><option>CMS Marina</option></sc-raw-select><sc-if value=\"{{ driverErr.from }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.from }}</span></sc-if></label>\n                      <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">To</span><sc-raw-select value=\"{{ driver.to }}\" sc-camel-on-change=\"{{ h.driver.to }}\" style=\"font-family:Urbanist;font-size:15px;padding:13px 12px;border:1.5px solid {{ driverBorder.to }};border-radius:11px;outline:none;background:#fff;\"><option value=\"\">End stop…</option><option>CMS Marina</option><option>Victoria Island</option><option>Lekki Phase 1</option><option>Chevron/Jakande</option><option>Sangotedo</option><option>Ajah</option></sc-raw-select><sc-if value=\"{{ driverErr.to }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.to }}</span></sc-if></label>\n                    </div>\n                    <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Usual Departure Time</span><input value=\"{{ driver.time }}\" sc-camel-on-input=\"{{ h.driver.time }}\" type=\"time\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:12px 15px;border:1.5px solid {{ driverBorder.time }};border-radius:11px;outline:none;\"><sc-if value=\"{{ driverErr.time }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.time }}</span></sc-if></label>\n                    <div>\n                      <span style=\"font-family:Urbanist;font-weight:600;font-size:13px;display:block;margin-bottom:10px;\">Days you drive</span>\n                      <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n                        <sc-for list=\"{{ dayChips }}\" as=\"day\" hint-placeholder-count=\"7\">\n                          <button sc-camel-on-click=\"{{ day.toggle }}\" style=\"font-family:Urbanist;font-weight:600;font-size:13.5px;padding:9px 16px;border-radius:100px;cursor:pointer;border:1.5px solid {{ day.border }};background:{{ day.bg }};color:{{ day.fg }};\">{{ day.label }}</button>\n                        </sc-for>\n                      </div>\n                      <sc-if value=\"{{ driverErr.days }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;margin-top:8px;display:block;\">{{ driverErr.days }}</span></sc-if>\n                    </div>\n                  </div>\n                </sc-if>\n                <!-- STEP 4 -->\n                <sc-if value=\"{{ ds4 }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"display:flex;flex-direction:column;gap:16px;\">\n                    <p style=\"font-family:Urbanist;font-size:14px;color:#5B6B63;margin:0;\">Upload clear photos. We verify within 48 hours.</p>\n                    <label style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px;border:1.5px dashed {{ driverBorder.license }};border-radius:14px;cursor:pointer;background:#FAFAF7;\">\n                      <span style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:14px;color:#0A1F18;\">Driver's License</span><span style=\"font-family:Urbanist;font-size:12.5px;color:{{ driver.license ? '#3CB371' : '#9AA8A1' }};\">{{ licenseLabel }}</span></span>\n                      <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#0F4C3A;background:#F5E6C8;padding:9px 16px;border-radius:9px;\">Browse</span>\n                      <input sc-camel-on-change=\"{{ h.driver.license }}\" type=\"file\" accept=\"image/*,.pdf\" style=\"display:none;\">\n                    </label>\n                    <label style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px;border:1.5px dashed {{ driverBorder.papers }};border-radius:14px;cursor:pointer;background:#FAFAF7;\">\n                      <span style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:14px;color:#0A1F18;\">Vehicle Papers</span><span style=\"font-family:Urbanist;font-size:12.5px;color:{{ driver.papers ? '#3CB371' : '#9AA8A1' }};\">{{ papersLabel }}</span></span>\n                      <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#0F4C3A;background:#F5E6C8;padding:9px 16px;border-radius:9px;\">Browse</span>\n                      <input sc-camel-on-change=\"{{ h.driver.papers }}\" type=\"file\" accept=\"image/*,.pdf\" style=\"display:none;\">\n                    </label>\n                    <sc-if value=\"{{ driverErr.docs }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ driverErr.docs }}</span></sc-if>\n                  </div>\n                </sc-if>\n\n                <div style=\"display:flex;gap:12px;margin-top:26px;\">\n                  <sc-if value=\"{{ driverCanBack }}\" hint-placeholder-val=\"{{ false }}\">\n                    <button sc-camel-on-click=\"{{ driverBack }}\" style=\"flex:0 0 auto;background:#F1F0EA;border:none;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:#41514A;padding:15px 24px;border-radius:12px;\">Back</button>\n                  </sc-if>\n                  <button sc-camel-on-click=\"{{ driverNext }}\" style=\"flex:1;background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#fff;padding:15px;border-radius:12px;\" style-hover=\"background:#14543B;\">{{ driverNextLabel }}</button>\n                </div>\n              </div>\n            </sc-if>\n          </div>\n        </sc-if>\n\n        <!-- FLEET ONBOARDING -->\n        <sc-if value=\"{{ modalFleet }}\" hint-placeholder-val=\"{{ false }}\">\n          <div>\n            <div style=\"background:#0A1F18;padding:28px 32px;position:relative;\">\n              <button sc-camel-on-click=\"{{ closeModal }}\" style=\"position:absolute;top:22px;right:24px;background:rgba(255,255,255,0.1);border:none;cursor:pointer;width:34px;height:34px;border-radius:50%;color:#fff;font-size:18px;\">×</button>\n              <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">TMO Fleet Onboarding</span>\n              <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:26px;color:#fff;margin:8px 0 0;\">Register your fleet, one form.</h3>\n            </div>\n\n            <sc-if value=\"{{ fleetDone }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:46px 36px;text-align:center;\">\n                <div style=\"width:74px;height:74px;border-radius:50%;background:#3CB371;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;font-size:36px;\">✓</div>\n                <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:25px;color:#0F4C3A;margin:0 0 12px;\">Fleet application received!</h3>\n                <p style=\"font-family:Urbanist;font-size:16px;line-height:1.6;color:#41514A;margin:0 0 26px;\">We'll verify your vehicles and set up your Fleet Dashboard within 48 hours.</p>\n                <button sc-camel-on-click=\"{{ closeModal }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#0A1F18;padding:14px 28px;border-radius:12px;\">Done</button>\n              </div>\n            </sc-if>\n\n            <sc-if value=\"{{ fleetFormOpen }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"padding:30px 32px 32px;max-height:64vh;overflow-y:auto;\">\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#0F4C3A;display:block;margin-bottom:12px;\">Fleet Owner</span>\n                <div style=\"display:flex;flex-direction:column;gap:16px;margin-bottom:8px;\">\n                  <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Full Name</span><input value=\"{{ fleet.name }}\" sc-camel-on-input=\"{{ h.fleet.name }}\" placeholder=\"e.g. Adebayo Kolawole\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ fleetBorder.name }};border-radius:11px;outline:none;\"><sc-if value=\"{{ fleetErr.name }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ fleetErr.name }}</span></sc-if></label>\n                  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n                    <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Phone</span><input value=\"{{ fleet.phone }}\" sc-camel-on-input=\"{{ h.fleet.phone }}\" placeholder=\"0913…\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ fleetBorder.phone }};border-radius:11px;outline:none;\"><sc-if value=\"{{ fleetErr.phone }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ fleetErr.phone }}</span></sc-if></label>\n                    <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Email</span><input value=\"{{ fleet.email }}\" sc-camel-on-input=\"{{ h.fleet.email }}\" placeholder=\"you@email.com\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ fleetBorder.email }};border-radius:11px;outline:none;\"><sc-if value=\"{{ fleetErr.email }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ fleetErr.email }}</span></sc-if></label>\n                  </div>\n                </div>\n\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;color:#0F4C3A;display:block;margin:20px 0 12px;\">Vehicles</span>\n                <sc-for list=\"{{ vehicleRows }}\" as=\"v\" hint-placeholder-count=\"1\">\n                  <div style=\"border:1.5px solid #E2E0D6;border-radius:14px;padding:16px;margin-bottom:14px;position:relative;\">\n                    <sc-if value=\"{{ v.canRemove }}\" hint-placeholder-val=\"{{ false }}\">\n                      <button sc-camel-on-click=\"{{ v.remove }}\" style=\"position:absolute;top:10px;right:10px;background:#F1F0EA;border:none;cursor:pointer;width:26px;height:26px;border-radius:50%;color:#41514A;font-size:14px;\">×</button>\n                    </sc-if>\n                    <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;color:#9AA8A1;display:block;margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px;\">Vehicle {{ v.n }}</span>\n                    <div style=\"display:flex;flex-direction:column;gap:12px;\">\n                      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Make</span><input value=\"{{ v.make }}\" sc-camel-on-input=\"{{ v.setMake }}\" placeholder=\"Toyota\" style=\"background:#fff;font-family:Urbanist;font-size:14.5px;padding:11px 13px;border:1.5px solid {{ v.borderMake }};border-radius:10px;outline:none;\"></label>\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Model</span><input value=\"{{ v.model }}\" sc-camel-on-input=\"{{ v.setModel }}\" placeholder=\"Hiace\" style=\"background:#fff;font-family:Urbanist;font-size:14.5px;padding:11px 13px;border:1.5px solid {{ v.borderModel }};border-radius:10px;outline:none;\"></label>\n                      </div>\n                      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Year</span><input value=\"{{ v.year }}\" sc-camel-on-input=\"{{ v.setYear }}\" placeholder=\"2019\" style=\"background:#fff;font-family:Urbanist;font-size:14.5px;padding:11px 13px;border:1.5px solid {{ v.borderYear }};border-radius:10px;outline:none;\"></label>\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Plate Number</span><input value=\"{{ v.plate }}\" sc-camel-on-input=\"{{ v.setPlate }}\" placeholder=\"LND 234 KJ\" style=\"background:#fff;font-family:Urbanist;font-size:14.5px;padding:11px 13px;border:1.5px solid {{ v.borderPlate }};border-radius:10px;outline:none;text-transform:uppercase;\"></label>\n                      </div>\n                      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Vehicle Type</span><sc-raw-select value=\"{{ v.type }}\" sc-camel-on-change=\"{{ v.setType }}\" style=\"font-family:Urbanist;font-size:14.5px;padding:11px 12px;border:1.5px solid {{ v.borderType }};border-radius:10px;outline:none;background:#fff;\"><option value=\"\">—</option><option>Bus</option><option>Sedan</option><option>Van</option><option>Keke</option></sc-raw-select></label>\n                        <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;\">Assigned Route</span><sc-raw-select value=\"{{ v.route }}\" sc-camel-on-change=\"{{ v.setRoute }}\" style=\"font-family:Urbanist;font-size:14.5px;padding:11px 12px;border:1.5px solid {{ v.borderRoute }};border-radius:10px;outline:none;background:#fff;\"><option value=\"\">—</option><option>Ajah → CMS Marina</option><option>Sangotedo → Victoria Island</option><option>Lekki Phase 1 → CMS Marina</option><option>Chevron/Jakande → Ajah</option><option>Island ↔ Mainland</option></sc-raw-select></label>\n                      </div>\n                    </div>\n                    <sc-if value=\"{{ v.err }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;display:block;margin-top:8px;\">{{ v.err }}</span></sc-if>\n                  </div>\n                </sc-for>\n                <button sc-camel-on-click=\"{{ addVehicle }}\" style=\"background:#F1F0EA;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:14px;color:#0F4C3A;padding:12px 18px;border-radius:11px;margin-bottom:22px;\">+ Add another vehicle</button>\n\n                <button sc-camel-on-click=\"{{ submitFleet }}\" style=\"width:100%;background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#fff;padding:15px;border-radius:12px;\" style-hover=\"background:#14543B;\">Submit fleet application</button>\n              </div>\n            </sc-if>\n          </div>\n        </sc-if>\n\n        <!-- COOPERATIVE -->\n        <sc-if value=\"{{ modalCoop }}\" hint-placeholder-val=\"{{ false }}\">\n          <div>\n            <div style=\"background:#FBC02D;padding:28px 32px;position:relative;\">\n              <button sc-camel-on-click=\"{{ closeModal }}\" style=\"position:absolute;top:22px;right:24px;background:rgba(10,31,24,0.12);border:none;cursor:pointer;width:34px;height:34px;border-radius:50%;color:#0A1F18;font-size:18px;\">×</button>\n              <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;letter-spacing:1.5px;color:#0F4C3A;text-transform:uppercase;\">TMO Cooperatives</span>\n              <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:26px;color:#0A1F18;margin:8px 0 0;\">Save together. Grow together.</h3>\n            </div>\n            <sc-if value=\"{{ coopDone }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:46px 36px;text-align:center;\">\n                <div style=\"width:74px;height:74px;border-radius:50%;background:#3CB371;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;font-size:36px;\">✓</div>\n                <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:25px;color:#0F4C3A;margin:0 0 12px;\">Welcome to the co-op!</h3>\n                <p style=\"font-family:Urbanist;font-size:16px;line-height:1.6;color:#41514A;margin:0 0 26px;\">Your membership application is in. We'll confirm your details and set up your first contribution.</p>\n                <button sc-camel-on-click=\"{{ closeModal }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#0A1F18;padding:14px 28px;border-radius:12px;\">Done</button>\n              </div>\n            </sc-if>\n            <sc-if value=\"{{ coopFormOpen }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;gap:18px;\">\n                <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n                  <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Full Name</span><input value=\"{{ coop.name }}\" sc-camel-on-input=\"{{ h.coop.name }}\" placeholder=\"Your name\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ coopBorder.name }};border-radius:11px;outline:none;\"><sc-if value=\"{{ coopErr.name }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ coopErr.name }}</span></sc-if></label>\n                  <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Phone</span><input value=\"{{ coop.phone }}\" sc-camel-on-input=\"{{ h.coop.phone }}\" placeholder=\"0913…\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ coopBorder.phone }};border-radius:11px;outline:none;\"><sc-if value=\"{{ coopErr.phone }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ coopErr.phone }}</span></sc-if></label>\n                </div>\n                <div>\n                  <span style=\"font-family:Urbanist;font-weight:600;font-size:13px;display:block;margin-bottom:10px;\">Membership Tier</span>\n                  <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                    <sc-for list=\"{{ coopTiers }}\" as=\"t\" hint-placeholder-count=\"3\">\n                      <button sc-camel-on-click=\"{{ t.select }}\" style=\"display:flex;justify-content:space-between;align-items:center;text-align:left;cursor:pointer;padding:15px 18px;border-radius:13px;border:1.5px solid {{ t.border }};background:{{ t.bg }};\">\n                        <span style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:MuseoModerno;font-weight:700;font-size:16px;color:#0A1F18;\">{{ t.name }}</span><span style=\"font-family:Urbanist;font-size:12.5px;color:#5B6B63;\">{{ t.desc }}</span></span>\n                        <span style=\"font-family:Urbanist;font-weight:700;font-size:14px;color:#0F4C3A;\">{{ t.price }}</span>\n                      </button>\n                    </sc-for>\n                  </div>\n                  <sc-if value=\"{{ coopErr.tier }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;margin-top:8px;display:block;\">{{ coopErr.tier }}</span></sc-if>\n                </div>\n                <label style=\"display:flex;flex-direction:column;gap:8px;\">\n                  <span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Monthly Contribution · <strong style=\"color:#0F4C3A;\">{{ coopAmountLabel }}</strong></span>\n                  <input type=\"range\" min=\"5000\" max=\"100000\" step=\"5000\" value=\"{{ coop.amount }}\" sc-camel-on-input=\"{{ h.coop.amount }}\" style=\"accent-color:#0F4C3A;\">\n                  <div style=\"display:flex;justify-content:space-between;font-family:Urbanist;font-size:11.5px;color:#9AA8A1;\"><span>₦5,000</span><span>₦100,000</span></div>\n                </label>\n                <button sc-camel-on-click=\"{{ submitCoop }}\" style=\"background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:16px;color:#fff;padding:16px;border-radius:13px;\" style-hover=\"background:#14543B;\">Join the Co-op</button>\n              </div>\n            </sc-if>\n          </div>\n        </sc-if>\n\n        <!-- LOGIN / REGISTER -->\n        <sc-if value=\"{{ modalLogin }}\" hint-placeholder-val=\"{{ false }}\">\n          <div>\n            <div style=\"background:#0F4C3A;padding:28px 32px;position:relative;\">\n              <button sc-camel-on-click=\"{{ closeModal }}\" style=\"position:absolute;top:22px;right:24px;background:rgba(255,255,255,0.12);border:none;cursor:pointer;width:34px;height:34px;border-radius:50%;color:#fff;font-size:18px;\">×</button>\n              <span style=\"font-family:MuseoModerno;font-weight:800;font-size:24px;color:#fff;letter-spacing:-1px;\">TMO</span>\n              <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:24px;color:#fff;margin:10px 0 0;\">{{ loginTitle }}</h3>\n            </div>\n            <sc-if value=\"{{ loginDone }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"padding:46px 36px;text-align:center;\">\n                <div style=\"width:74px;height:74px;border-radius:50%;background:#3CB371;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;font-size:36px;\">✓</div>\n                <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:24px;color:#0F4C3A;margin:0 0 12px;\">{{ loginSuccessTitle }}</h3>\n                <p style=\"font-family:Urbanist;font-size:16px;color:#41514A;margin:0 0 26px;\">Welcome back to your TMO dashboard.</p>\n                <button sc-camel-on-click=\"{{ closeModal }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#0A1F18;padding:14px 28px;border-radius:12px;\">Continue</button>\n              </div>\n            </sc-if>\n            <sc-if value=\"{{ loginFormOpen }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;gap:16px;\">\n                <sc-if value=\"{{ isRegister }}\" hint-placeholder-val=\"{{ false }}\">\n                  <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Full Name</span><input value=\"{{ login.name }}\" sc-camel-on-input=\"{{ h.login.name }}\" placeholder=\"Your name\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ loginBorder.name }};border-radius:11px;outline:none;\"><sc-if value=\"{{ loginErr.name }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ loginErr.name }}</span></sc-if></label>\n                </sc-if>\n                <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Email or Phone</span><input value=\"{{ login.email }}\" sc-camel-on-input=\"{{ h.login.email }}\" placeholder=\"you@email.com\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ loginBorder.email }};border-radius:11px;outline:none;\"><sc-if value=\"{{ loginErr.email }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ loginErr.email }}</span></sc-if></label>\n                <label style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;\">Password</span><input value=\"{{ login.password }}\" sc-camel-on-input=\"{{ h.login.password }}\" type=\"password\" placeholder=\"••••••••\" style=\"background:#fff;font-family:Urbanist;font-size:15px;padding:13px 15px;border:1.5px solid {{ loginBorder.password }};border-radius:11px;outline:none;\"><sc-if value=\"{{ loginErr.password }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-family:Urbanist;font-size:12.5px;color:#D14343;\">{{ loginErr.password }}</span></sc-if></label>\n                <button sc-camel-on-click=\"{{ submitLogin }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:16px;color:#0A1F18;padding:16px;border-radius:13px;margin-top:4px;\" style-hover=\"background:#ffce4d;\">{{ loginCta }}</button>\n                <p style=\"font-family:Urbanist;font-size:13.5px;color:#5B6B63;text-align:center;margin:4px 0 0;\">{{ loginSwitchText }} <span sc-camel-on-click=\"{{ toggleLoginMode }}\" style=\"color:#0F4C3A;font-weight:700;cursor:pointer;\">{{ loginSwitchCta }}</span></p>\n              </div>\n            </sc-if>\n          </div>\n        </sc-if>\n\n      </div>\n    </div>\n  </sc-if>\n\n</div>\n\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  constructor(props){\n    super(props);\n    this.rootRef = React.createRef();\n    this.navRef = React.createRef();\n    this.journeyRef = React.createRef();\n    this.trackRef = React.createRef();\n    this.aboutRef = React.createRef();\n    this.servicesRef = React.createRef();\n    this.cardRef = React.createRef();\n    this.routesRef = React.createRef();\n    this.contactRef = React.createRef();\n    this.suggestRef = React.createRef();\n    this.leadershipRef = React.createRef();\n    this.productsRef = React.createRef();\n    this.fleetRef = React.createRef();\n    this.busRef = React.createRef();\n    this.busFlipRef = React.createRef();\n    this.busBobRef = React.createRef();\n    this.msRoadRef = React.createRef();\n    this.msBusRef = React.createRef();\n    this.BUS_STOPS = [\n      { left:22, color:'#3CB371' }, { left:30, color:'#FBC02D' }, { left:40, color:'#0F4C3A' },\n      { left:48, color:'#0A1F18' }, { left:56, color:'#FBC02D' }, { left:64, color:'#3CB371' }\n    ];\n    this._lastProg = 0;\n    this.state = {\n      page:'home', productsOpen:false, mobileMenu:false, activeProduct:0, hoverLeader:null,\n      modal:null, driverStep:1,\n      card:{name:'',phone:'',email:'',service:'',id:''}, cardErr:{}, cardDone:false,\n      driver:{name:'',phone:'',email:'',make:'',model:'',year:'',color:'',seats:'',plate:'',from:'',to:'',time:'',days:[],license:'',papers:''}, driverErr:{}, driverDone:false,\n      fleet:{name:'',phone:'',email:'',vehicles:[{make:'',model:'',year:'',plate:'',type:'',route:''}]}, fleetErr:{}, vehicleErr:[], fleetDone:false,\n      coop:{name:'',phone:'',tier:'',amount:25000}, coopErr:{}, coopDone:false,\n      contact:{name:'',email:'',subject:'',message:''}, contactErr:{}, contactDone:false,\n      suggest:{name:'',phone:'',from:'',to:'',willing:'',amount:15000}, suggestErr:{}, suggestDone:false,\n      login:{name:'',email:'',password:''}, loginErr:{}, loginDone:false, loginMode:'login'\n    };\n  }\n\n  componentDidMount(){\n    this._reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    this._scroller = this.findScroller();\n    this._onScroll = () => this.handleScroll();\n    // capture phase catches scroll from inner scroll containers (window may not be the scroller in this host)\n    window.addEventListener('scroll', this._onScroll, true);\n    window.addEventListener('resize', this._onScroll, {passive:true});\n    if(this._scroller && this._scroller.addEventListener) this._scroller.addEventListener('scroll', this._onScroll, {passive:true});\n    this.handleScroll();\n    setTimeout(()=>{ this._scroller = this.findScroller(); this.handleScroll(); }, 350);\n    setTimeout(()=>this.handleScroll(), 1000);\n    try{ const h=(location.hash||'').replace('#',''); if(['home','products','about','routes','leadership','blog'].indexOf(h)>=0) this.setState({page:h}); }catch(e){}\n    this._onHash = ()=>{ const h=(location.hash||'').replace('#','')||'home'; if(['home','products','about','routes','leadership','blog'].indexOf(h)>=0) this.setState({page:h}); };\n    window.addEventListener('hashchange', this._onHash);\n  }\n  componentWillUnmount(){\n    window.removeEventListener('scroll', this._onScroll, true);\n    window.removeEventListener('resize', this._onScroll);\n    if(this._scroller && this._scroller.removeEventListener) this._scroller.removeEventListener('scroll', this._onScroll);\n    window.removeEventListener('hashchange', this._onHash);\n  }\n  findScroller(){\n    let el = this.rootRef.current ? this.rootRef.current.parentElement : null;\n    while(el && el !== document.documentElement){\n      const s = getComputedStyle(el);\n      if((s.overflowY==='auto'||s.overflowY==='scroll'||s.overflowY==='overlay') && (el.scrollHeight - el.clientHeight) > 40) return el;\n      el = el.parentElement;\n    }\n    return document.scrollingElement || document.documentElement;\n  }\n\n  handleScroll(){\n    const sc = this._scroller;\n    const y = (sc && sc.scrollTop != null) ? sc.scrollTop : (window.scrollY || window.pageYOffset || 0);\n    const vh = (sc && sc.clientHeight) ? sc.clientHeight : window.innerHeight;\n    const vw = (sc && sc.clientWidth) ? sc.clientWidth : window.innerWidth;\n    if(this.navRef.current){\n      this.navRef.current.style.boxShadow = y>24 ? '0 10px 34px rgba(0,0,0,0.28)' : 'none';\n      this.navRef.current.style.background = y>24 ? 'rgba(10,31,24,0.95)' : 'rgba(10,31,24,0.82)';\n    }\n    const sec = this.journeyRef.current, track = this.trackRef.current;\n    if(sec && track){\n      const rect = sec.getBoundingClientRect();\n      const total = sec.offsetHeight - vh;\n      const prog = Math.min(1, Math.max(0, (-rect.top)/total));\n      const max = track.scrollWidth - vw;\n      track.style.transform = 'translateX(' + (-prog*max) + 'px)';\n      this.updateBus(prog);\n    }\n    this.updateMilestoneBus(vh);\n    if(this.rootRef.current){\n      const counters = this.rootRef.current.querySelectorAll('[data-count]');\n      counters.forEach(el=>{\n        const r = el.getBoundingClientRect();\n        if(r.top < vh*0.9 && r.bottom > 0 && !el._counted) this.animateCount(el);\n      });\n    }\n  }\n\n  updateBus(prog){\n    const bus = this.busRef.current, flip = this.busFlipRef.current, bob = this.busBobRef.current;\n    if(!bus) return;\n    const stops = this.BUS_STOPS, n = stops.length;\n    const idxF = prog * (n - 1);\n    const idx = Math.max(0, Math.min(n - 2, Math.floor(idxF)));\n    const frac = idxF - idx;\n    const a = stops[idx], b = stops[idx + 1];\n    const leftPct = a.left + (b.left - a.left) * frac;\n    const color = frac < 0.5 ? a.color : b.color;\n    bus.style.left = leftPct + '%';\n    bus.style.backgroundColor = color;\n    if(this._reducedMotion){\n      bus.style.transition = 'none';\n      if(bob) bob.classList.remove('tmo-bus-bobbing');\n      return;\n    }\n    const delta = prog - this._lastProg;\n    this._lastProg = prog;\n    if(flip) flip.style.transform = delta < -0.0001 ? 'scaleX(-1)' : 'scaleX(1)';\n    if(bob){\n      bob.classList.add('tmo-bus-bobbing');\n      clearTimeout(this._busBobTimer);\n      this._busBobTimer = setTimeout(()=>{ if(bob) bob.classList.remove('tmo-bus-bobbing'); }, 150);\n    }\n  }\n\n  updateMilestoneBus(vh){\n    const road = this.msRoadRef.current, bus = this.msBusRef.current;\n    if(!road || !bus) return;\n    const rect = road.getBoundingClientRect();\n    const refY = vh*0.45;\n    const prog = Math.min(1, Math.max(0, (refY - rect.top)/rect.height));\n    const busH = 34;\n    const top = prog*(rect.height - busH);\n    bus.style.transform = 'translate(-50%,' + top + 'px)';\n    const busCenter = rect.top + top + busH/2;\n    let anyActive = false;\n    road.querySelectorAll('[data-ms-marker]').forEach(m=>{\n      const row = m.closest('[data-ms-row]');\n      const card = row ? row.querySelector('[data-ms-card]') : null;\n      const mRect = m.getBoundingClientRect();\n      const mCenter = mRect.top + mRect.height/2;\n      const passed = busCenter >= mCenter - 8;\n      const active = Math.abs(busCenter - mCenter) < 65;\n      if(active) anyActive = true;\n      m.classList.toggle('ms-marker-active', active);\n      m.style.background = passed ? '#0F4C3A' : '#fff';\n      if(card) card.classList.toggle('ms-card-active', active);\n    });\n    bus.classList.toggle('ms-bus-lit', anyActive);\n  }\n\n  animateCount(el){\n    if(el._counted) return; el._counted = true;\n    const target = parseFloat(el.getAttribute('data-count'))||0;\n    const suffix = el.getAttribute('data-suffix')||'';\n    el._final = target + suffix;\n    const dur = 1500, start = performance.now();\n    const step = (t)=>{\n      const p = Math.min(1,(t-start)/dur);\n      const e = 1-Math.pow(1-p,3);\n      el.textContent = Math.round(target*e) + suffix;\n      if(p<1) requestAnimationFrame(step);\n    };\n    requestAnimationFrame(step);\n  }\n\n  goto(page, ref){\n    this.setState({page, mobileMenu:false, productsOpen:false}, ()=>{\n      try{ history.replaceState(null, '', '#'+page); }catch(e){}\n      const sc = this._scroller || this.findScroller();\n      const doScroll = ()=>{\n        const el = ref && ref.current ? ref.current : null;\n        if(el){\n          const cur = (sc && sc.scrollTop!=null) ? sc.scrollTop : (window.scrollY||0);\n          const top = el.getBoundingClientRect().top + cur - 64;\n          if(sc && sc.scrollTo) sc.scrollTo({top, behavior:'smooth'}); else if(sc) sc.scrollTop = top; else window.scrollTo({top});\n        } else {\n          if(sc && sc.scrollTo) sc.scrollTo({top:0, behavior:'auto'}); else if(sc) sc.scrollTop = 0; window.scrollTo({top:0});\n        }\n        this.handleScroll();\n      };\n      setTimeout(doScroll, ref ? 70 : 0);\n    });\n  }\n  go(ref){ this.goto(this.state.page, ref); }\n\n  setField(group, key){\n    return (e)=>{\n      let v;\n      if(e && e.target){\n        if(e.target.type === 'file'){ v = e.target.files && e.target.files[0] ? e.target.files[0].name : ''; }\n        else { v = e.target.value; }\n      } else { v = e; }\n      this.setState(s=>({[group]: Object.assign({}, s[group], {[key]: v})}));\n    };\n  }\n\n  // validation\n  vName(s){ return s && s.trim() ? '' : 'Required'; }\n  vPhone(s){ return /^[0-9+\\s-]{7,}$/.test(s||'') ? '' : 'Enter a valid phone'; }\n  vEmail(s){ return /^\\S+@\\S+\\.\\S+$/.test(s||'') ? '' : 'Enter a valid email'; }\n  errs(obj){ const e={}; Object.keys(obj).forEach(k=>{ if(obj[k]) e[k]=obj[k]; }); return e; }\n\n  submitCard = ()=>{\n    const c = this.state.card;\n    const e = this.errs({ name:this.vName(c.name)&&'Enter your full name', phone:this.vPhone(c.phone), email:this.vEmail(c.email), service:c.service?'':'Select a service', id:c.id&&c.id.trim()?'':'Enter your NIN or BVN' });\n    this.setState({cardErr:e});\n    if(Object.keys(e).length===0) this.setState({cardDone:true});\n  };\n  resetCard = ()=> this.setState({card:{name:'',phone:'',email:'',service:'',id:''}, cardErr:{}, cardDone:false});\n\n  submitContact = ()=>{\n    const c = this.state.contact;\n    const e = this.errs({ name:this.vName(c.name)&&'Enter your name', email:this.vEmail(c.email), subject:c.subject?'':'Pick a topic', message:c.message&&c.message.trim().length>4?'':'Tell us a little more' });\n    this.setState({contactErr:e});\n    if(Object.keys(e).length===0) this.setState({contactDone:true});\n  };\n  resetContact = ()=> this.setState({contact:{name:'',email:'',subject:'',message:''}, contactErr:{}, contactDone:false});\n\n  submitSuggest = ()=>{\n    const c = this.state.suggest;\n    const e = this.errs({ name:this.vName(c.name)&&'Enter your name', phone:this.vPhone(c.phone), from:c.from&&c.from.trim()?'':'Where does it start?', to:c.to&&c.to.trim()?'':'Where should we go?', willing:c.willing?'':'Let us know' });\n    this.setState({suggestErr:e});\n    if(Object.keys(e).length===0) this.setState({suggestDone:true});\n  };\n  resetSuggest = ()=> this.setState({suggest:{name:'',phone:'',from:'',to:'',willing:'',amount:15000}, suggestErr:{}, suggestDone:false});\n  setWilling = (v)=> ()=> this.setState(s=>({suggest:Object.assign({},s.suggest,{willing:v}), suggestErr:Object.assign({},s.suggestErr,{willing:undefined})}));\n\n  submitCoop = ()=>{\n    const c = this.state.coop;\n    const e = this.errs({ name:this.vName(c.name)&&'Enter your name', phone:this.vPhone(c.phone), tier:c.tier?'':'Choose a membership tier' });\n    this.setState({coopErr:e});\n    if(Object.keys(e).length===0) this.setState({coopDone:true});\n  };\n  selectTier = (t)=> ()=> this.setState(s=>({coop:Object.assign({},s.coop,{tier:t}), coopErr:Object.assign({},s.coopErr,{tier:undefined})}));\n\n  toggleDay = (d)=> ()=> this.setState(s=>{\n    const has = s.driver.days.indexOf(d)>=0;\n    const days = has ? s.driver.days.filter(x=>x!==d) : s.driver.days.concat([d]);\n    return {driver:Object.assign({},s.driver,{days})};\n  });\n\n  driverNext = ()=>{\n    const d = this.state.driver, step = this.state.driverStep; let e = {};\n    if(step===1){ e = this.errs({ name:this.vName(d.name)&&'Enter your name', phone:this.vPhone(d.phone), email:this.vEmail(d.email) }); }\n    else if(step===2){ e = this.errs({ make:this.vName(d.make)&&'Required', model:this.vName(d.model)&&'Required', year:/^(19|20)\\d{2}$/.test(d.year)?'':'YYYY', color:this.vName(d.color)&&'Required', seats:d.seats?'':'?', plate:this.vName(d.plate)&&'Enter plate' }); }\n    else if(step===3){ e = this.errs({ from:d.from?'':'Pick a start', to:d.to?'':'Pick an end', time:d.time?'':'Set a time', days:d.days.length?'':'Pick at least one day' }); }\n    else if(step===4){ e = this.errs({ docs:(d.license&&d.papers)?'':'Upload both documents' }); if(Object.keys(e).length===0){ this.setState({driverErr:{}, driverDone:true}); return; } }\n    this.setState({driverErr:e});\n    if(Object.keys(e).length===0 && step<4) this.setState({driverStep:step+1, driverErr:{}});\n  };\n  driverBack = ()=> this.setState(s=>({driverStep:Math.max(1,s.driverStep-1), driverErr:{}}));\n\n  submitLogin = ()=>{\n    const l = this.state.login, reg = this.state.loginMode==='register'; let chk = { email:this.vEmail(l.email)||(/^[0-9+\\s-]{7,}$/.test(l.email)?'':''), password:l.password&&l.password.length>=4?'':'Min 4 characters' };\n    if(/^[0-9+\\s-]{7,}$/.test(l.email)) chk.email='';\n    if(reg) chk.name = this.vName(l.name)&&'Enter your name';\n    const e = this.errs(chk);\n    this.setState({loginErr:e});\n    if(Object.keys(e).length===0) window.location.href='https://cmstnm.com/login';\n  };\n  toggleLoginMode = ()=> this.setState(s=>({loginMode:s.loginMode==='login'?'register':'login', loginErr:{}, loginDone:false}));\n\n  selectProduct = (i)=>{ this.setState({activeProduct:i}); this.goto('products', this.productsRef); };\n  openModal = (m)=> ()=> this.setState({modal:m, mobileMenu:false, productsOpen:false});\n  closeModal = ()=> this.setState({modal:null, driverStep:1, driverDone:false, coopDone:false, loginDone:false, fleetDone:false});\n\n  emptyVehicle(){ return {make:'',model:'',year:'',plate:'',type:'',route:''}; }\n  addVehicle = ()=> this.setState(s=>({ fleet: Object.assign({}, s.fleet, { vehicles: s.fleet.vehicles.concat([this.emptyVehicle()]) }) }));\n  removeVehicle = (i)=> ()=> this.setState(s=>({ fleet: Object.assign({}, s.fleet, { vehicles: s.fleet.vehicles.filter((_,idx)=>idx!==i) }) }));\n  setVehicleField = (i, key)=> (e)=>{\n    const v = (e && e.target) ? e.target.value : e;\n    this.setState(s=>{\n      const vehicles = s.fleet.vehicles.slice();\n      vehicles[i] = Object.assign({}, vehicles[i], {[key]: v});\n      return { fleet: Object.assign({}, s.fleet, { vehicles }) };\n    });\n  };\n  submitFleet = ()=>{\n    const f = this.state.fleet;\n    const e = this.errs({ name:this.vName(f.name)&&'Enter your name', phone:this.vPhone(f.phone), email:this.vEmail(f.email) });\n    const vErrs = f.vehicles.map(v=> (v.make&&v.model&&v.year&&v.plate&&v.type&&v.route) ? '' : 'Fill in every field for this vehicle');\n    this.setState({fleetErr:e, vehicleErr:vErrs});\n    if(Object.keys(e).length===0 && vErrs.every(x=>!x)) this.setState({fleetDone:true});\n  };\n\n  renderVals(){\n    const st = this.state;\n    const bd = (group, errs)=>{ const o={}; Object.keys(group).forEach(k=>{ o[k] = (st[errs]&&st[errs][k]) ? '#E5A3A3' : '#E2E0D6'; }); return o; };\n    // handlers\n    const groups = { card:['name','phone','email','service','id'], driver:['name','phone','email','make','model','year','color','seats','plate','from','to','time','license','papers'], fleet:['name','phone','email'], coop:['name','phone','amount'], contact:['name','email','subject','message'], suggest:['name','phone','from','to','amount'], login:['name','email','password'] };\n    const h = {};\n    Object.keys(groups).forEach(g=>{ h[g]={}; groups[g].forEach(k=>{ h[g][k]=this.setField(g,k); }); });\n\n    const naira = (n)=> '₦' + (Number(n)||0).toLocaleString('en-NG');\n    const m = st.modal;\n    const reg = st.loginMode==='register';\n    const dstep = st.driverStep;\n\n    const heroNodes = [0,1,2,3,4,5,6].map(i=>{ const deg=-90 + i*(360/7); const a=deg*Math.PI/180; return { x:Math.round(Math.cos(a)*118), y:Math.round(Math.sin(a)*118), deg:Math.round(deg*10)/10, len:118, delay:(i*0.35).toFixed(2) }; });\n\n    const coopGroups = [\n      { n:'01', name:'Kajola Inner Circle', desc:'Built around indigenes of Lagos and Ogun States.' },\n      { n:'02', name:'Irepodun Kwara Drivers Circle', desc:'Predominantly indigenes of all LGAs of Kwara State.' },\n      { n:'03', name:'Ebedi United Brothers', desc:'Indigenes of towns in Oyo State around Iseyin and its environs.' },\n      { n:'04', name:'Ifelodun Oluyole United Brothers', desc:'Predominantly Ibadan indigenes of Oyo State.' },\n      { n:'05', name:'Osun United Brothers', desc:'Predominantly all towns and villages in Osun State.' },\n      { n:'06', name:'Ifesowapo United Brothers', desc:'Ondo State and the South-Eastern States of Nigeria.' },\n      { n:'07', name:'Oyo Atiba Brothers Nigeria', desc:'Predominantly indigenes of Oyo town.' }\n    ];\n    const coopAdvantages = [\n      { n:'01', t:'Decision-making is democratised across every group.' },\n      { n:'02', t:'Each cooperative grows at its own pace and takes risk as it sees fit.' },\n      { n:'03', t:'Each functions as a business unit with maximum autonomy from CMS T&M.' },\n      { n:'04', t:'Members hold strong affinity, self-report to the company, and the company steps in when a matter exceeds a single group.' }\n    ];\n    const iloBenefits = [\n      { t:'Economic Empowerment', d:'Better access to resources, shared equipment, and improved market linkages that boost member income.' },\n      { t:'Decent Work & Job Creation', d:'Job creation across sectors and improved working conditions for members.' },\n      { t:'Social Protection', d:'A safety net for informal and rural-economy workers, including health insurance.' },\n      { t:'Inclusivity & Empowerment', d:'Participation of women, youth, and people with disabilities — and a tool against child labour.' },\n      { t:'Democratic Governance', d:'One member, one vote — prioritising community welfare over profit maximisation.' }\n    ];\n\n    const affiliations = [\n      { name:'BRTAN', full:'BRT Association of Nigeria', desc:'A member of BRTAN — and an equity stakeholder. Our membership reflects the CMS T&M vision of a transport system built on the cooperative model.' },\n      { name:'LAMATA', full:'Lagos Metropolitan Area Transport Authority', desc:'Registered with the Lagos State agency responsible for planning, implementing, regulating, and franchising public transport infrastructure and operations.' },\n      { name:'NURTW', full:'National Union of Road Transport Workers', desc:'A registered member of the union for road transport workers — affiliated with the Nigeria Labour Congress, managing motor parks and promoting safety.' }\n    ];\n    const aboutValues = ['Structure','Accountability','Safety','Service Excellence','Sustainability','Cooperative Integrity','Discipline','Innovation'];\n    const milestones = [\n      { year:'1968', desc:'Established by a group of taxi drivers as the Taxi Drivers Friendship Association. Started with taxi driving and metamorphosed into a high-capacity buses public transportation business.' },\n      { year:'1978', desc:'Hit 1 million passenger volume after 10 years of operation.' },\n      { year:'1988', desc:'Hit 15 million riders volume after 20 years of operation.' },\n      { year:'2002', desc:'Fully registered as CMS Taxi & Motor Nigeria Limited, with 7 associations each contributing a Director to the Board.' },\n      { year:'2010–2012', desc:'Passenger volume hit 30 million as operational capacity grew with 10 new 50-seater high-capacity buses, bringing the fleet to 20 buses.' },\n      { year:'2014–2019', desc:'Passenger capacity hit 50 million with 29 additional 50-seater high-capacity buses, bringing the fleet to 49 buses.' },\n      { year:'2026', desc:'Full digitisation of the business with the TMO mobile app — driving legacy rides, intrastate and interstate travel, the logistics business, and the cooperative business.' }\n    ];\n    const pillars = [\n      { n:'01', t:'Experience', d:'Nearly six decades through every business cycle — COVID-19, the 2020 EndSARS protests on our Lekki–Ajah route, the 2022 diesel shock, and the 2023 Naira redesign — weathered with equanimity and grace.' },\n      { n:'02', t:'Management Team', d:'Almost six decades of growth traceable to a team that understands public transportation deeply, complementing the cooperative model with strong manpower management.' },\n      { n:'03', t:'Technology', d:'Technology sits at the front of how we run — and through a partnership with cmstaxiandmotor, a Canadian mobility-tech company that took a 10% equity stake in 2021, we keep improving the commuter ride.' },\n      { n:'04', t:'Network Effects', d:'Our capabilities have taken our public-transport services beyond Lagos to places as far as Nasarawa State and beyond.' },\n      { n:'05', t:'Accountability', d:'A household name for accountability — with no liability left undischarged since inception, as our bankers can attest.' }\n    ];\n    const aboutMission = 'To provide safe, reliable, and professionally managed public transportation and logistics services through disciplined governance, regulatory compliance, and operational excellence.';\n    const aboutVision = \"To become Nigeria's leading cooperative-driven transport and logistics institution, delivering structured, regulated, and sustainable mobility solutions for a growing nation.\";\n\n    const productMenu = [\n      { name:'TMO X', tag:'Executive rides', mark:'X', bg:'#3CB371', fg:'#fff', go:()=>this.selectProduct(1) },\n      { name:'Ride-Along', tag:'Smart carpool', mark:'R', bg:'#0F4C3A', fg:'#fff', go:()=>this.selectProduct(0) },\n      { name:'Logistics', tag:'Move anything', mark:'L', bg:'#0A1F18', fg:'#fff', go:()=>this.selectProduct(2) },\n      { name:'Cooperatives', tag:'Save & borrow', mark:'C', bg:'#FBC02D', fg:'#0A1F18', go:()=>this.selectProduct(3) }\n    ];\n\n    const products = [\n      { id:'ride', name:'TMO Ride-Along', kicker:'Carpooling · Lekki–Ajah', shortTag:'Smart carpool', mark:'R', tag:'Your daily commute, shared smarter.', desc:'Carpool with people going your way, at your time. Affordable, structured, and cashless — powered by your TMO card.', cta:'Learn more', bg:'#0F4C3A', fg:'#fff', tagColor:'#7FE0AC', body:'rgba(255,255,255,0.72)', iconBg:'rgba(255,255,255,0.12)', blob:'rgba(60,179,113,0.18)', iconEl:'👥',\n        full1:\"TMO Ride-Along is Lagos' most structured carpooling experience. Built for the daily commuter who knows the Lekki–Ajah corridor like the back of their hand, it connects people heading the same way at the same time — turning solo commutes into shared, affordable, and predictable journeys.\",\n        full2:'You pick your route. You pick your time. We handle the rest. No empty buses. No wasted seats. No wahala.',\n        steps:[{n:'1',t:'Open the TMO app or website and select “Ride-Along”.'},{n:'2',t:'Enter your pickup point and destination along the corridor.'},{n:'3',t:'See other commuters going your way, at your time.'},{n:'4',t:'Confirm your seat and tap your TMO card at the stop.'},{n:'5',t:'Ride together. Split the cost. Arrive together.'}],\n        bestFor:'Daily workers, students, and commuters on fixed schedules along the Lekki–Ajah expressway.',\n        faq:[{q:'Is it cashless?',a:'Yes — fares are paid by tapping your TMO card at the stop.'},{q:'Do I need to book ahead?',a:'Confirm your seat before the trip so we can match you with commuters going your way.'}],\n        ctaLabel:'Get a TMO Card to ride', action:()=>this.goto('products', this.cardRef) },\n      { id:'x', name:'TMO X', kicker:'Executive Rides · Earn', shortTag:'Drive & earn', mark:'X', tag:\"You're already going. Make it count.\", desc:'Own a car? Drive your usual route and earn by filling empty seats — without changing your schedule.', cta:'Learn more', bg:'#3CB371', fg:'#fff', tagColor:'rgba(255,255,255,0.95)', body:'rgba(255,255,255,0.9)', iconBg:'rgba(255,255,255,0.18)', blob:'rgba(255,255,255,0.16)', iconEl:'🚗',\n        full1:\"TMO X is not a taxi app. It's a smart mobility platform for people who own cars and are already driving to work — turning everyday commutes into income without disrupting your routine.\",\n        full2:'List your route, your departure time, and how many seats you have. Commuters on that route see your vehicle, your rating, and your ETA — and request to ride with you. You earn. They ride. Lagos moves smarter.',\n        steps:[{n:'1',t:'Register as a TMO X Driver — submit your vehicle details and route.'},{n:'2',t:'Before your trip, log in and activate your route on the platform.'},{n:'3',t:'Commuters along your route see your listing and request a seat.'},{n:'4',t:\"Accept the requests that work for you — you're always in control.\"},{n:'5',t:'Pick them up on your way. Earn per seat filled. No detours required.'}],\n        bestFor:'Car owners who commute daily and want to offset fuel costs or fill empty seats on their regular route.',\n        faq:[{q:'Do I have to change my route?',a:'No. You only accept commuters already on your way — no detours.'},{q:'How do I get paid?',a:'Earnings are credited per seat to your TMO wallet automatically.'}],\n        ctaLabel:'Register as a TMO X Driver', action:this.openModal('driver') },\n      { id:'logistics', name:'TMO Logistics', kicker:'Goods · Property · Parcels', shortTag:'Move anything', mark:'L', tag:'Move it. Trust it. Track it.', desc:'From parcels to full household moves — handled with the discipline of Nigeria\\u2019s most structured transport institution.', cta:'Learn more', bg:'#0A1F18', fg:'#fff', tagColor:'#7FE0AC', body:'rgba(255,255,255,0.7)', iconBg:'rgba(255,255,255,0.1)', blob:'rgba(60,179,113,0.14)', iconEl:'📦',\n        full1:\"TMO Logistics is your reliable partner for moving goods, property, and packages across Lagos — backed by CMS T&M's 58-year operational infrastructure.\",\n        full2:'Relocating your home, sending business inventory across town, or shipping from the Island to the Mainland — TMO Logistics provides structured, accountable, tracked delivery. No guesswork. No ghost drivers. No missing packages.',\n        steps:[{n:'1',t:'Submit a logistics request via the website or MOAT app.'},{n:'2',t:'Describe your item(s), pickup address, and destination.'},{n:'3',t:'Receive a quote and schedule your pickup window.'},{n:'4',t:'A verified TMO Logistics operator picks up and transports your goods.'},{n:'5',t:'Track your delivery in real time. Receive confirmation on arrival.'}],\n        bestFor:'Households relocating, small businesses moving inventory, and individuals sending packages across Lagos.',\n        faq:[{q:'Can I track my delivery?',a:'Yes — every delivery is tracked in real time until confirmed on arrival.'},{q:'What can you move?',a:'From parcels to full household moves — tell us your items and we will quote it.'}],\n        ctaLabel:'Request a pickup', action:()=>{ this.setState(s=>({contact:Object.assign({},s.contact,{subject:'Logistics Request'})})); this.goto('home', this.contactRef); } },\n      { id:'coop', name:'TMO Cooperatives', kicker:'Save · Borrow · Grow', shortTag:'Save & borrow', mark:'C', tag:'Save together. Grow together. Borrow with confidence.', desc:'Membership in CMS T&M’s 58-year cooperative model. Save monthly, build credit, and access fair loans — member-governed, one member, one vote.', cta:'Learn more', bg:'#FBC02D', fg:'#0A1F18', tagColor:'#7a5c0e', body:'rgba(10,31,24,0.72)', iconBg:'rgba(10,31,24,0.1)', blob:'rgba(255,255,255,0.3)', iconEl:'🌱',\n        full1:\"TMO Cooperatives opens CMS T&M's 58-year cooperative model to members. The institution is organised around independent transport groups — each with its own leaders, members, and governance — all submitting to the limited liability company known today as CMS T&M. It's not a bank. It's a member-governed society where the people who save are the people who benefit.\",\n        full2:'Members save consistently, build a shared pool of funds, and access low-interest loans when they need them. Decisions are democratic — one member, one vote — and risk is shared across the cooperative, the same structure that has kept CMS T&M resilient for decades.',\n        steps:[{n:'1',t:'Apply for TMO Cooperative membership via the website.'},{n:'2',t:'Set your monthly savings contribution.'},{n:'3',t:'Build your savings history over time.'},{n:'4',t:'When eligible, apply for a loan — at rates far below commercial lenders.'},{n:'5',t:'Repay on a structured schedule. Your savings stay intact.'}],\n        bestFor:'TMO drivers, commuters, staff, and community members who want structured savings and fair credit.',\n        faq:[{q:'Is this a bank?',a:'No — it is a member-governed cooperative society. Governance is democratic: one member, one vote, community welfare over profit.'},{q:'How is it structured?',a:'Around CMS T&M’s seven transport cooperative groups, each with its own leaders and members, all submitting to the company.'}],\n        ctaLabel:'Join the Co-op', action:this.openModal('coop') },\n      { id:'interstate', name:'TMO Interstate Travel', kicker:'Long-distance · Abuja–Lagos', shortTag:'Abuja–Lagos', mark:'I', tag:'Cross the country in comfort.', desc:'Scheduled long-distance coaches between Lagos and Abuja — reserved seats, fixed departures, and cashless fares on your TMO card.', cta:'Learn more', bg:'#134E3A', fg:'#fff', tagColor:'#7FE0AC', body:'rgba(255,255,255,0.72)', iconBg:'rgba(255,255,255,0.12)', blob:'rgba(60,179,113,0.18)', iconEl:'🛣️',\n        full1:\"TMO Interstate Travel connects Lagos and Abuja with scheduled, long-distance coaches — built on CMS T&M's structured, safety-first operating standards and the reliability of a 58-year transport institution.\",\n        full2:'Reserve your seat, travel on a fixed schedule, and pay cashless with your TMO card. No haggling at the park. No endless waiting for the bus to fill. Just a dependable ride across the country.',\n        steps:[{n:'1',t:'Open the TMO app or website and select “Interstate Travel”.'},{n:'2',t:'Choose the Abuja–Lagos route and your travel date.'},{n:'3',t:'Pick your departure time and reserve your seat.'},{n:'4',t:'Pay cashless with your TMO card or wallet.'},{n:'5',t:'Arrive at the terminal, board, and travel in comfort.'}],\n        bestFor:'Travellers moving between Lagos and Abuja who want scheduled departures, reserved seats, and cashless fares.',\n        faq:[{q:'Which routes are available?',a:'The Abuja–Lagos corridor is live now, with more interstate routes being added.'},{q:'Can I reserve a seat in advance?',a:'Yes — reserve and pay ahead so your seat is guaranteed before departure.'}],\n        ctaLabel:'Book an interstate trip', action:()=>{ this.setState(s=>({contact:Object.assign({},s.contact,{subject:'Interstate Travel — Abuja/Lagos'})})); this.goto('home', this.contactRef); } },\n      { id:'intrastate', name:'TMO Intrastate Travels', kicker:'Within Lagos · Multiple routes', shortTag:'Across Lagos', mark:'T', tag:'Move across the city, the structured way.', desc:'Regulated intrastate routes across Lagos — CMS–Lekki–Ajah–Epe, Festac–CMS and Festac–Oshodi — with fixed stops and cashless tap-to-pay.', cta:'Learn more', bg:'#3CB371', fg:'#fff', tagColor:'rgba(255,255,255,0.95)', body:'rgba(255,255,255,0.9)', iconBg:'rgba(255,255,255,0.18)', blob:'rgba(255,255,255,0.16)', iconEl:'🚌',\n        full1:\"TMO Intrastate Travels moves you across Lagos on structured, regulated routes — the same corridors CMS T&M has operated for decades, now digitised, cashless, and predictable.\",\n        full2:'Active routes include CMS–Lekki–Ajah–Epe, Festac–CMS and Festac–Oshodi. Choose your route, board at a designated stop, and tap to pay with your TMO card. Regulated fares, fixed stops, and reliable travel times across the city.',\n        steps:[{n:'1',t:'Open the TMO app or website and select “Intrastate Travels”.'},{n:'2',t:'Pick your route — CMS–Lekki–Ajah–Epe, Festac–CMS or Festac–Oshodi.'},{n:'3',t:'Head to the designated boarding stop for your route.'},{n:'4',t:'Tap your TMO card to pay — fully cashless.'},{n:'5',t:'Board and ride on a regulated, predictable schedule.'}],\n        bestFor:'Daily commuters, traders, and students travelling across Lagos on the CMS, Lekki–Ajah–Epe, Festac and Oshodi corridors.',\n        faq:[{q:'Which routes run?',a:'CMS–Lekki–Ajah–Epe, Festac–CMS and Festac–Oshodi, with more routes added regularly.'},{q:'How do I pay?',a:'Tap your TMO card at the stop — fares are fully cashless and regulated.'}],\n        ctaLabel:'Ride an intrastate route', action:()=>{ this.setState(s=>({contact:Object.assign({},s.contact,{subject:'Intrastate Travels — Lagos routes'})})); this.goto('home', this.contactRef); } }\n    ];\n    const services = products.map((p,i)=>Object.assign({}, p, { openDetail:()=>this.selectProduct(i) }));\n    const activeP = products[this.state.activeProduct] || products[0];\n    const productTabs = products.map((p,i)=>{ const on=this.state.activeProduct===i; return { mark:p.mark, name:p.name, shortTag:p.shortTag, tileBg:p.bg, tileFg:p.fg, border:on?'#0F4C3A':'#E7E3D6', bg:on?'#F0F7F3':'#FAFAF7', select:()=>this.selectProduct(i) }; });