ki-Ajah corridor. Today, we power CMS T&amp;M with <strong style=\"color:#fff;font-weight:700;\">TMO</strong> - our digital mobility platform.</p>\n        <div style=\"display:flex;flex-wrap:wrap;gap:14px;\">\n          <button sc-camel-on-click=\"{{ goProducts }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:16px;color:#0A1F18;padding:17px 30px;border-radius:14px;box-shadow:0 14px 34px -10px rgba(251,192,45,0.6);\" style-hover=\"transform:translateY(-2px);\">Explore the TMO Platform</button>\n          <button sc-camel-on-click=\"{{ goAbout }}\" style=\"background:transparent;border:1.5px solid rgba(255,255,255,0.4);cursor:pointer;font-family:Urbanist;font-weight:600;font-size:16px;color:#fff;padding:16px 28px;border-radius:14px;\" style-hover=\"border-color:#fff;background:rgba(255,255,255,0.06);\">About CMS&nbsp;T&amp;M</button>\n        </div>\n        <div style=\"display:flex;flex-wrap:wrap;gap:12px;margin:-12px 0 28px;\">\n          <div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:12px;\">\n  <div style=\"margin-top:40px;color:white;\">Install the TMO apps</div>\n        <div style=\"display:flex;flex-wrap:nowrap;align-items:stretch;justify-content:flex-start;gap:12px;margin-top:1px;\">\n \n            <a href=\"https://play.google.com/store/apps/details?id=com.tnm.rider\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-flex;flex:0 0 248px;align-items:center;gap:12px;background:#050505;border:2px solid rgba(255,255,255,0.75);border-radius:16px;padding:10px 16px 10px 14px;text-decoration:none;box-shadow:0 18px 38px -24px rgba(0,0,0,0.75);min-width:248px;\">\n              <svg width=\"34\" height=\"38\" viewBox=\"0 0 34 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"display:block;flex:none;\">\n                <path d=\"M2.8 2.35c-.49.52-.8 1.33-.8 2.39v28.52c0 1.03.29 1.82.75 2.34l.12.11L19.3 19.31v-.62L2.91 2.24l-.11.11Z\" fill=\"#00D26A\"></path>\n                <path d=\"M24.76 24.79 19.3 19.31v-.62l5.52-5.52.12.07 6.47 3.7c1.85 1.05 1.85 2.77 0 3.84l-6.53 3.73-.12.28Z\" fill=\"#FFD84D\"></path>\n                <path d=\"M24.88 24.51 19.3 18.93 2.8 35.43c.77.82 2.05.93 3.5.12l18.58-10.59Z\" fill=\"#FF5252\"></path>\n                <path d=\"M24.88 13.49 6.3 2.9C4.84 2.08 3.56 2.2 2.8 3.02l16.5 16.51 5.58-5.58Z\" fill=\"#3B82F6\"></path>\n              </svg>\n              <span style=\"display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:2px;\">\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;line-height:1;letter-spacing:0.12em;color:#FFFFFF;text-transform:uppercase;\">Get TMO On</span>\n                <span style=\"font-family:Urbanist;font-weight:800;font-size:28px;line-height:1;color:#FFFFFF;letter-spacing:-0.03em;\">Google Play</span>\n              </span>\n            </a>\n            <a href=\"https://play.google.com/store/apps/details?id=com.tnm.driver\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-flex;flex:0 0 248px;align-items:center;gap:12px;background:#050505;border:2px solid rgba(255,255,255,0.75);border-radius:16px;padding:10px 16px 10px 14px;text-decoration:none;box-shadow:0 18px 38px -24px rgba(0,0,0,0.75);min-width:248px;\">\n              <svg width=\"34\" height=\"38\" viewBox=\"0 0 34 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"display:block;flex:none;\">\n                <path d=\"M2.8 2.35c-.49.52-.8 1.33-.8 2.39v28.52c0 1.03.29 1.82.75 2.34l.12.11L19.3 19.31v-.62L2.91 2.24l-.11.11Z\" fill=\"#00D26A\"></path>\n                <path d=\"M24.76 24.79 19.3 19.31v-.62l5.52-5.52.12.07 6.47 3.7c1.85 1.05 1.85 2.77 0 3.84l-6.53 3.73-.12.28Z\" fill=\"#FFD84D\"></path>\n                <path d=\"M24.88 24.51 19.3 18.93 2.8 35.43c.77.82 2.05.93 3.5.12l18.58-10.59Z\" fill=\"#FF5252\"></path>\n                <path d=\"M24.88 13.49 6.3 2.9C4.84 2.08 3.56 2.2 2.8 3.02l16.5 16.51 5.58-5.58Z\" fill=\"#3B82F6\"></path>\n              </svg>\n              <span style=\"display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:2px;\">\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;line-height:1;letter-spacing:0.12em;color:#FFFFFF;text-transform:uppercase;\">Get TMO Driver On</span>\n                <span style=\"font-family:Urbanist;font-weight:800;font-size:28px;line-height:1;color:#FFFFFF;letter-spacing:-0.03em;\">Google Play</span>\n              </span>\n            </a>\n          </div>\n          \n        </div>\n        </div>\n      </div>\n      <div style=\"position:relative;display:flex;align-items:center;justify-content:center;min-height:420px;animation:revealIn .9s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 50%;\">\n        <div style=\"position:absolute;width:340px;height:60px;bottom:40px;border-radius:50%;background:radial-gradient(ellipse,rgba(60,179,113,0.45),transparent 70%);filter:blur(24px);animation:tmoPulse 6s ease-in-out infinite;\"></div>\n        <div style=\"position:relative;width:100%;max-width:560px;\">\n          <dc-import name=\"TMO Hero Animation\" hint-size=\"100%,420px\"></dc-import>\n        </div>\n      </div>\n    </div>\n    <div sc-camel-on-click=\"{{ goAbout }}\" style=\"position:absolute;bottom:30px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;animation:tmoBounce 2.4s ease-in-out infinite;\">\n      <span style=\"font-family:Urbanist;font-size:11px;letter-spacing:1.5px;color:rgba(255,255,255,0.4);text-transform:uppercase;\">Scroll</span>\n      <span style=\"width:11px;height:11px;border-right:2px solid #3CB371;border-bottom:2px solid #3CB371;transform:rotate(45deg);\"></span>\n    </div>\n  </header>\n\n  <!-- ================= TRUST MARQUEE ================= -->\n  <section style=\"background:#0A1F18;padding:26px 0;overflow:hidden;border-top:1px solid rgba(60,179,113,0.12);\">\n    <div style=\"display:flex;width:max-content;animation:tmoMarquee 32s linear infinite;\">\n      <div style=\"display:flex;gap:14px;padding-right:14px;\">\n        <sc-for list=\"{{ trustItems }}\" as=\"t\" hint-placeholder-count=\"6\">\n          <span style=\"display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-family:Urbanist;font-weight:600;font-size:15px;color:rgba(255,255,255,0.8);padding:11px 22px;border:1px solid rgba(60,179,113,0.3);border-radius:100px;\">\n            <span style=\"width:6px;height:6px;border-radius:50%;background:#3CB371;\"></span>{{ t }}\n          </span>\n        </sc-for>\n      </div>\n      <div style=\"display:flex;gap:14px;padding-right:14px;\" aria-hidden=\"true\">\n        <sc-for list=\"{{ trustItems }}\" as=\"t\" hint-placeholder-count=\"6\">\n          <span style=\"display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-family:Urbanist;font-weight:600;font-size:15px;color:rgba(255,255,255,0.8);padding:11px 22px;border:1px solid rgba(60,179,113,0.3);border-radius:100px;\">\n            <span style=\"width:6px;height:6px;border-radius:50%;background:#3CB371;\"></span>{{ t }}\n          </span>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showAbout }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= ABOUT ================= -->\n  <section ref=\"{{ aboutRef }}\" style=\"background:#FFFFFF;padding:120px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;\" data-about-grid=\"\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">The Institution Behind TMO</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.04;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 24px;\">Built on 58 years of Lagos transport.</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 18px;\">CMS&nbsp;T&amp;M has operated the Lekki–Ajah Transport Corridor for over five decades, making it one of Nigeria's most enduring public transportation institutions. Headquartered at the Marina in Lagos, it is registered with LAMATA and affiliated with BRTAN and NURTW.</p>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 32px;\">TMO is the digital face of that institution — bringing structure, accountability, and reliability to every commuter in Lagos.</p>\n        <div style=\"display:flex;gap:12px;\">\n          <a href=\"https://play.google.com/store/apps/details?id=com.tnm.rider\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:flex;align-items:center;gap:10px;padding:12px 18px;background:#F5E6C8;border-radius:12px;text-decoration:none;\">\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:14px;color:#0F4C3A;\">📱 Download TMO App</span>\n          </a>\n        </div>\n      </div>\n      <div data-reveal=\"\" data-reveal-delay=\"120\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <div style=\"position:relative;border-radius:24px;overflow:hidden;aspect-ratio:1.15;background:linear-gradient(165deg,#F5E6C8 0%,#EAD9A8 100%);box-shadow:0 30px 60px -24px rgba(15,76,58,0.3);\">\n          <!-- abstract Marina scene -->\n          <div style=\"position:absolute;inset:0;background:linear-gradient(180deg,#BFE3CF 0%,#F5E6C8 55%);\"></div>\n          <div style=\"position:absolute;top:40px;right:48px;width:88px;height:88px;border-radius:50%;background:radial-gradient(circle,#FBC02D,#F2A93C);box-shadow:0 0 60px rgba(251,192,45,0.6);animation:tmoSun 8s ease-in-out infinite;\"></div>\n          <div style=\"position:absolute;bottom:34%;left:0;right:0;display:flex;align-items:flex-end;gap:8px;padding:0 30px;opacity:0.55;\">\n            <span style=\"flex:1;height:70px;background:#0F4C3A;border-radius:4px 4px 0 0;\"></span>\n            <span style=\"flex:1;height:110px;background:#14543B;border-radius:4px 4px 0 0;\"></span>\n            <span style=\"flex:1;height:80px;background:#0F4C3A;border-radius:4px 4px 0 0;\"></span>\n            <span style=\"flex:1;height:140px;background:#0A2A1F;border-radius:4px 4px 0 0;\"></span>\n            <span style=\"flex:1;height:95px;background:#14543B;border-radius:4px 4px 0 0;\"></span>\n            <span style=\"flex:1;height:120px;background:#0F4C3A;border-radius:4px 4px 0 0;\"></span>\n          </div>\n          <div style=\"position:absolute;bottom:0;left:0;right:0;height:34%;background:linear-gradient(180deg,#3CB371,#1A6349);\"></div>\n          <div style=\"position:absolute;bottom:16%;left:18%;width:120px;height:32px;background:#0A1F18;border-radius:6px 16px 4px 4px;opacity:0.85;\"></div>\n          <div style=\"position:absolute;bottom:14%;right:14%;width:70px;height:22px;background:#0A2A1F;border-radius:4px 12px 4px 4px;opacity:0.7;\"></div>\n          <span style=\"position:absolute;bottom:18px;left:24px;font-family:'Courier New',monospace;font-size:11px;letter-spacing:1px;color:rgba(255,255,255,0.6);\">CMS MARINA · LAGOS ISLAND</span>\n        </div>\n      </div>\n    </div>\n    <!-- stats -->\n    <div style=\"max-width:980px;margin:84px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;\" data-stats-grid=\"\">\n      <sc-for list=\"{{ stats }}\" as=\"s\" hint-placeholder-count=\"4\">\n        <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;text-align:center;padding:32px 16px;border-radius:18px;background:#F8F7F2;border:1px solid #ECE7DA;\">\n          <div style=\"display:flex;align-items:baseline;justify-content:center;\">\n            <span data-count=\"{{ s.num }}\" data-suffix=\"{{ s.suffix }}\" style=\"font-family:MuseoModerno;font-weight:800;font-size:54px;letter-spacing:-2px;color:#0F4C3A;line-height:1;\">{{ s.final }}</span>\n          </div>\n          <span style=\"font-family:Urbanist;font-weight:500;font-size:14px;color:#5B6B63;margin-top:10px;display:block;\">{{ s.label }}</span>\n        </div>\n      </sc-for>\n    </div>\n  </section>\n\n  <!-- ================= ABOUT — INSTITUTION IN FULL ================= -->\n  <section style=\"background:radial-gradient(120% 100% at 30% 0%,#15573F,#0F4C3A 55%,#0A2A1F);padding:120px 40px;\">\n    <div style=\"max-width:1180px;margin:0 auto;\">\n      <div style=\"max-width:740px;margin:0 auto 56px;text-align:center;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">We are CMS&nbsp;T&amp;M</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:44px;line-height:1.05;letter-spacing:-1.5px;color:#fff;margin:16px 0 18px;\">Regulated, affiliated, and accountable.</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:rgba(255,255,255,0.72);margin:0;\">Operator of the Lekki–Ajah Transport Corridor, headquartered at the Marina in Lagos — built on a cooperative model and governed by the bodies that keep Lagos moving.</p>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:80px;\" data-affil-grid=\"\">\n        <sc-for list=\"{{ affiliations }}\" as=\"af\" hint-placeholder-count=\"3\">\n          <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(60,179,113,0.22);border-radius:18px;padding:28px;animation:revealIn .8s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 46%;\" style-hover=\"border-color:rgba(60,179,113,0.5);\">\n            <h3 style=\"font-family:MuseoModerno;font-weight:800;font-size:26px;letter-spacing:-0.5px;color:#fff;margin:0 0 4px;\">{{ af.name }}</h3>\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;color:#7FE0AC;display:block;margin-bottom:14px;\">{{ af.full }}</span>\n            <p style=\"font-family:Urbanist;font-size:14.5px;line-height:1.6;color:rgba(255,255,255,0.7);margin:0;\">{{ af.desc }}</p>\n          </div>\n        </sc-for>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;\" data-mv-grid=\"\">\n        <div style=\"background:rgba(255,255,255,0.05);border-left:4px solid #3CB371;border-radius:16px;padding:32px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 44%;\">\n          <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">Mission</span>\n          <p style=\"font-family:MuseoModerno;font-weight:500;font-size:21px;line-height:1.4;color:#fff;margin:14px 0 0;\">{{ aboutMission }}</p>\n        </div>\n        <div style=\"background:rgba(255,255,255,0.05);border-left:4px solid #FBC02D;border-radius:16px;padding:32px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 44%;\">\n          <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1.5px;color:#FBC02D;text-transform:uppercase;\">Vision</span>\n          <p style=\"font-family:MuseoModerno;font-weight:500;font-size:21px;line-height:1.4;color:#fff;margin:14px 0 0;\">{{ aboutVision }}</p>\n        </div>\n      </div>\n      <div style=\"display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:84px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 44%;\">\n        <sc-for list=\"{{ aboutValues }}\" as=\"v\" hint-placeholder-count=\"8\">\n          <span style=\"font-family:Urbanist;font-weight:600;font-size:14px;color:rgba(255,255,255,0.85);border:1px solid rgba(60,179,113,0.3);border-radius:100px;padding:9px 18px;\">{{ v }}</span>\n        </sc-for>\n      </div>\n\n      <div style=\"max-width:680px;margin:0 auto 36px;text-align:center;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">Our success in public transportation</span>\n        <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:32px;line-height:1.12;letter-spacing:-1px;color:#fff;margin:14px 0 0;\">Why we've endured for nearly six decades.</h3>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:64px;\" data-pillars-grid=\"\">\n        <sc-for list=\"{{ pillars }}\" as=\"p\" hint-placeholder-count=\"5\">\n          <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:28px;animation:revealIn .8s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 46%;\">\n            <span style=\"font-family:MuseoModerno;font-weight:800;font-size:24px;color:#FBC02D;display:block;margin-bottom:10px;\">{{ p.n }}</span>\n            <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:20px;color:#fff;margin:0 0 8px;\">{{ p.t }}</h4>\n            <p style=\"font-family:Urbanist;font-size:14.5px;line-height:1.6;color:rgba(255,255,255,0.68);margin:0;\">{{ p.d }}</p>\n          </div>\n        </sc-for>\n      </div>\n\n      <p style=\"max-width:760px;margin:0 auto;text-align:center;font-family:MuseoModerno;font-weight:600;font-size:26px;line-height:1.3;letter-spacing:-0.5px;color:#fff;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">Driving Lagos forward through <span style=\"color:#3CB371;\">disciplined and regulated</span> public transportation.</p>\n    </div>\n  </section>\n\n  <!-- ================= MILESTONES ================= -->\n  <section style=\"background:#FFFFFF;padding:120px 40px;\">\n    <div style=\"max-width:900px;margin:0 auto;\">\n      <div style=\"text-align:center;max-width:640px;margin:0 auto 72px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">The Journey</span>\n        <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:34px;line-height:1.12;letter-spacing:-1px;color:#0F4C3A;margin:14px 0 0;\">Milestones along the road.</h3>\n        <p style=\"font-family:Urbanist;font-size:16px;line-height:1.6;color:rgba(15,31,24,0.6);margin:14px 0 0;\">Hop on — the bus takes you through nearly six decades of the road we've travelled.</p>\n      </div>\n      <div ref=\"{{ msRoadRef }}\" style=\"position:relative;\">\n        <div style=\"position:absolute;left:35px;top:11px;bottom:11px;width:6px;transform:translateX(-50%);background:#2B2B2B;border-radius:4px;\"></div>\n        <div style=\"position:absolute;left:35px;top:11px;bottom:11px;width:2px;transform:translateX(-50%);background-image:repeating-linear-gradient(to bottom,#FBC02D 0,#FBC02D 12px,transparent 12px,transparent 26px);\"></div>\n        <div ref=\"{{ msBusRef }}\" style=\"position:absolute;left:35px;top:0;width:56px;height:34px;transform:translate(-50%,0);z-index:3;border-radius:8px 16px 6px 6px;background:#3CB371;box-shadow:0 8px 20px rgba(0,0,0,0.25);\">\n          <div style=\"position:absolute;top:6px;left:8px;display:flex;gap:5px;\">\n            <span style=\"width:14px;height:11px;background:rgba(255,255,255,0.55);border-radius:2px;\"></span>\n            <span style=\"width:14px;height:11px;background:rgba(255,255,255,0.55);border-radius:2px;\"></span>\n            <span style=\"width:10px;height:11px;background:rgba(255,255,255,0.4);border-radius:2px;\"></span>\n          </div>\n          <div style=\"position:absolute;bottom:-4px;left:9px;width:11px;height:11px;border-radius:50%;background:#1A1A1A;border:2px solid #ccc;\"></div>\n          <div style=\"position:absolute;bottom:-4px;right:9px;width:11px;height:11px;border-radius:50%;background:#1A1A1A;border:2px solid #ccc;\"></div>\n        </div>\n        <sc-for list=\"{{ milestones }}\" as=\"m\" hint-placeholder-count=\"7\">\n          <div data-ms-row=\"\" style=\"position:relative;display:flex;gap:28px;align-items:flex-start;padding-bottom:56px;\">\n            <div style=\"position:relative;flex:0 0 70px;display:flex;justify-content:center;padding-top:4px;\">\n              <div data-ms-marker=\"\" style=\"width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid #0F4C3A;z-index:2;box-shadow:0 4px 10px rgba(0,0,0,0.08);transition:box-shadow .3s ease;\"></div>\n            </div>\n            <div data-ms-card=\"\" style=\"background:#fff;border:1px solid rgba(15,76,58,0.1);border-radius:18px;padding:26px 30px;flex:1;box-shadow:0 8px 24px rgba(0,0,0,0.05);transition:all .35s cubic-bezier(.16,1,.3,1);\">\n              <span style=\"font-family:MuseoModerno;font-weight:800;font-size:22px;color:#0F4C3A;\">{{ m.year }}</span>\n              <p style=\"font-family:Urbanist;font-size:15px;line-height:1.6;color:rgba(15,31,24,0.72);margin:8px 0 0;\">{{ m.desc }}</p>\n            </div>\n          </div>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showProducts }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= SERVICES ================= -->\n  <section ref=\"{{ servicesRef }}\" style=\"background:#F5E6C8;padding:120px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;text-align:center;max-width:640px;margin:0 auto 64px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;\">The Products</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.05;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 0;\">Everything you need to move in Lagos.</h2>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:24px;\" data-services-grid=\"\">\n        <sc-for list=\"{{ services }}\" as=\"sv\" hint-placeholder-count=\"4\">\n          <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;position:relative;border-radius:24px;overflow:hidden;background:{{ sv.bg }};padding:38px;min-height:300px;display:flex;flex-direction:column;box-shadow:0 24px 50px -28px rgba(10,31,24,0.4);\" style-hover=\"transform:translateY(-6px);\">\n            <div style=\"position:absolute;top:-40px;right:-40px;width:160px;height:160px;border-radius:50%;background:{{ sv.blob }};filter:blur(6px);\"></div>\n            <div style=\"position:relative;display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:15px;background:{{ sv.iconBg }};margin-bottom:24px;color:{{ sv.fg }};\">{{ sv.iconEl }}</div>\n            <h3 style=\"position:relative;font-family:MuseoModerno;font-weight:700;font-size:27px;letter-spacing:-0.5px;color:{{ sv.fg }};margin:0 0 6px;\">{{ sv.name }}</h3>\n            <p style=\"position:relative;font-family:Urbanist;font-weight:600;font-style:italic;font-size:15px;color:{{ sv.tagColor }};margin:0 0 16px;\">{{ sv.tag }}</p>\n            <p style=\"position:relative;font-family:Urbanist;font-size:15.5px;line-height:1.6;color:{{ sv.body }};margin:0 0 26px;max-width:90%;\">{{ sv.desc }}</p>\n            <button sc-camel-on-click=\"{{ sv.openDetail }}\" style=\"position:relative;margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;gap:8px;background:transparent;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:{{ sv.fg }};padding:0;\" style-hover=\"gap:14px;\">{{ sv.cta }} <span style=\"font-size:18px;\">→</span></button>\n          </div>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= VISIT US ================= -->\n\n\n  <section ref=\"{{ cardRef }}\" style=\"background:#FFFFFF;padding:110px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:32px;align-items:start;\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;max-width:560px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;\">TMO Card</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.05;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 14px;\">Get your TMO Card</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 18px;\">Request your TMO Card and start riding cashless across supported routes.</p>\n        <div style=\"display:grid;gap:10px;margin-top:16px;\">\n          <div style=\"display:flex;gap:10px;align-items:flex-start;\"><span style=\"font-size:16px;line-height:1.5;\">&#10003;</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.6;color:#41514A;\">Cashless taps at stops</span></div>\n          <div style=\"display:flex;gap:10px;align-items:flex-start;\"><span style=\"font-size:16px;line-height:1.5;\">&#10003;</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.6;color:#41514A;\">One card for your daily commute</span></div>\n          <div style=\"display:flex;gap:10px;align-items:flex-start;\"><span style=\"font-size:16px;line-height:1.5;\">&#10003;</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.6;color:#41514A;\">Fast onboarding with NIN/BVN verification</span></div>\n        </div>\n      </div>\n  </section>\n\n  <!-- ================= PRODUCT DETAIL (in-depth) ================= -->\n  <section ref=\"{{ productsRef }}\" style=\"background:#FFFFFF;padding:110px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;\">\n      <div style=\"text-align:center;max-width:680px;margin:0 auto 52px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">The TMO Platform · In Detail</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:44px;line-height:1.05;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 0;\">Four services, one institution.</h2>\n      </div>\n      <div style=\"display:grid;grid-template-columns:300px 1fr;gap:30px;align-items:start;\" data-products-grid=\"\">\n        <!-- tabs -->\n        <div style=\"display:flex;flex-direction:column;gap:10px;position:sticky;top:88px;\" data-product-tabs=\"\">\n          <sc-for list=\"{{ productTabs }}\" as=\"pt\" hint-placeholder-count=\"4\">\n            <button sc-camel-on-click=\"{{ pt.select }}\" style=\"display:flex;align-items:center;gap:14px;text-align:left;cursor:pointer;padding:15px 16px;border-radius:16px;border:1.5px solid {{ pt.border }};background:{{ pt.bg }};transition:border-color .2s,background .2s;\">\n              <span style=\"width:40px;height:40px;flex-shrink:0;border-radius:12px;background:{{ pt.tileBg }};display:flex;align-items:center;justify-content:center;color:{{ pt.tileFg }};font-family:MuseoModerno;font-weight:800;font-size:17px;\">{{ pt.mark }}</span>\n              <span style=\"display:flex;flex-direction:column;gap:1px;\">\n                <span style=\"font-family:MuseoModerno;font-weight:700;font-size:16px;color:#0A1F18;\">{{ pt.name }}</span>\n                <span style=\"font-family:Urbanist;font-size:12.5px;color:#5B6B63;\">{{ pt.shortTag }}</span>\n              </span>\n            </button>\n          </sc-for>\n        </div>\n        <!-- detail panel -->\n        <div style=\"border-radius:24px;overflow:hidden;border:1px solid #ECE7DA;background:#fff;box-shadow:0 30px 70px -38px rgba(10,31,24,0.45);\">\n          <div style=\"position:relative;overflow:hidden;padding:44px 44px 40px;background:{{ activeP.bg }};\">\n            <div style=\"position:absolute;top:-60px;right:-50px;width:200px;height:200px;border-radius:50%;background:{{ activeP.blob }};filter:blur(8px);\"></div>\n            <span style=\"position:relative;font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1.5px;color:{{ activeP.tagColor }};text-transform:uppercase;\">{{ activeP.kicker }}</span>\n            <h3 style=\"position:relative;font-family:MuseoModerno;font-weight:800;font-size:40px;letter-spacing:-1px;color:{{ activeP.fg }};margin:12px 0 10px;\">{{ activeP.name }}</h3>\n            <p style=\"position:relative;font-family:Urbanist;font-weight:600;font-style:italic;font-size:17px;color:{{ activeP.tagColor }};margin:0;\">{{ activeP.tag }}</p>\n          </div>\n          <div style=\"padding:38px 44px 44px;\">\n            <p style=\"font-family:Urbanist;font-size:16.5px;line-height:1.7;color:#2C3A34;margin:0 0 16px;\">{{ activeP.full1 }}</p>\n            <p style=\"font-family:Urbanist;font-size:16.5px;line-height:1.7;color:#41514A;margin:0 0 34px;\">{{ activeP.full2 }}</p>\n\n            <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:14px;letter-spacing:1.2px;text-transform:uppercase;color:#3CB371;margin:0 0 18px;\">How it works</h4>\n            <div style=\"display:flex;flex-direction:column;gap:14px;margin-bottom:34px;\">\n              <sc-for list=\"{{ activeP.steps }}\" as=\"st\" hint-placeholder-count=\"5\">\n                <div style=\"display:flex;align-items:flex-start;gap:16px;\">\n                  <span style=\"flex-shrink:0;width:34px;height:34px;border-radius:10px;background:#F5E6C8;display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:800;font-size:15px;color:#0F4C3A;\">{{ st.n }}</span>\n                  <span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.5;color:#2C3A34;padding-top:5px;\">{{ st.t }}</span>\n                </div>\n              </sc-for>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;padding:16px 20px;border-radius:14px;background:#F0F7F3;border:1px solid #D9EBE1;margin-bottom:34px;\">\n              <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:.5px;color:#0F4C3A;text-transform:uppercase;flex-shrink:0;padding-top:1px;\">Best for</span>\n              <span style=\"font-family:Urbanist;font-size:15px;line-height:1.5;color:#2C3A34;\">{{ activeP.bestFor }}</span>\n            </div>\n\n            <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:14px;letter-spacing:1.2px;text-transform:uppercase;color:#3CB371;margin:0 0 16px;\">Common questions</h4>\n            <div style=\"display:flex;flex-direction:column;gap:14px;margin-bottom:36px;\">\n              <sc-for list=\"{{ activeP.faq }}\" as=\"f\" hint-placeholder-count=\"2\">\n                <div style=\"border-left:3px solid #FBC02D;padding-left:16px;\">\n                  <div style=\"font-family:Urbanist;font-weight:700;font-size:15px;color:#0A1F18;margin-bottom:3px;\">{{ f.q }}</div>\n                  <div style=\"font-family:Urbanist;font-size:14.5px;line-height:1.55;color:#5B6B63;\">{{ f.a }}</div>\n                </div>\n              </sc-for>\n            </div>\n\n            <button sc-camel-on-click=\"{{ activeP.action }}\" style=\"background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:16px;color:#fff;padding:16px 30px;border-radius:13px;\" style-hover=\"background:#14543B;\">{{ activeP.ctaLabel }} →</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= HOW TMO X WORKS ================= -->\n  <section style=\"position:relative;background:#0A1F18;padding:120px 40px;overflow:hidden;\">\n    <div style=\"position:absolute;top:-100px;right:-60px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(60,179,113,0.16),transparent 65%);filter:blur(10px);\"></div>\n    <div style=\"position:relative;max-width:1200px;margin:0 auto;\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;max-width:620px;margin-bottom:60px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">TMO X · Driver Focus</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.04;letter-spacing:-1.5px;color:#FFFFFF;margin:16px 0 18px;\">Turn your commute into income.</h2>\n        <p style=\"font-family:Urbanist;font-size:18px;line-height:1.6;color:rgba(255,255,255,0.65);margin:0;\">If you drive to work daily, you're leaving money in your seat. TMO X connects you with commuters on your exact route — no detours, no disruption.</p>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:48px;\" data-steps-grid=\"\">\n        <sc-for list=\"{{ driverSteps }}\" as=\"d\" hint-placeholder-count=\"3\">\n          <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;position:relative;padding:34px 30px;border-radius:20px;background:rgba(255,255,255,0.04);border:1px solid rgba(60,179,113,0.18);\">\n            <span style=\"font-family:MuseoModerno;font-weight:800;font-size:18px;color:#0A1F18;background:#FBC02D;width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:22px;\">{{ d.n }}</span>\n            <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:21px;color:#fff;margin:0 0 10px;\">{{ d.title }}</h3>\n            <p style=\"font-family:Urbanist;font-size:15px;line-height:1.6;color:rgba(255,255,255,0.6);margin:0;\">{{ d.text }}</p>\n          </div>\n        </sc-for>\n      </div>\n      <button sc-camel-on-click=\"{{ openDriver }}\" style=\"background:#FBC02D;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:16px;color:#0A1F18;padding:17px 30px;border-radius:14px;box-shadow:0 14px 34px -12px rgba(251,192,45,0.5);\" style-hover=\"transform:translateY(-2px);\">Register as a TMO X Driver →</button>\n    </div>\n  </section>\n\n  \n\n  </sc-if>\n\n  <sc-if value=\"{{ showRoutes }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= COMMUTER JOURNEY (signature) ================= -->\n  <section ref=\"{{ routesRef }}\" style=\"background:#FFFFFF;padding:90px 40px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;text-align:center;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n      <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">Active TMO Routes</span>\n      <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.04;letter-spacing:-1.5px;color:#0F4C3A;margin:16px auto 14px;max-width:680px;\">The Lekki–Ajah Corridor, from dawn to dusk.</h2>\n      <p style=\"font-family:Urbanist;font-size:17px;line-height:1.6;color:#5B6B63;max-width:560px;margin:0 auto 22px;\">Scroll to ride the corridor — six structured stops, predictable times, regulated fares.</p>\n      <button sc-camel-on-click=\"{{ goSuggest }}\" style=\"display:inline-flex;align-items:center;gap:9px;background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#fff;padding:15px 26px;border-radius:13px;\" style-hover=\"background:#14543B;\">Suggest a route <span style=\"font-size:17px;\">→</span></button>\n    </div>\n  </section>\n  <section ref=\"{{ journeyRef }}\" style=\"position:relative;height:560vh;background:#FFFFFF;\">\n    <div style=\"position:sticky;top:0;height:100vh;overflow:hidden;\">\n      <div ref=\"{{ trackRef }}\" style=\"display:flex;height:100%;width:max-content;will-change:transform;\">\n        <sc-for list=\"{{ journeyPanels }}\" as=\"j\" hint-placeholder-count=\"6\">\n          <div style=\"width:100vw;height:100%;position:relative;background:{{ j.sky }};display:flex;align-items:flex-end;overflow:hidden;\">\n            <div style=\"position:absolute;top:{{ j.sunTop }};left:{{ j.sunLeft }};width:130px;height:130px;border-radius:50%;background:{{ j.sun }};box-shadow:0 0 90px {{ j.sunGlow }};animation:tmoSun 9s ease-in-out infinite;\"></div>\n            <!-- skyline -->\n            <div style=\"position:absolute;bottom:30%;left:0;right:0;display:flex;align-items:flex-end;gap:10px;padding:0 6%;opacity:{{ j.cityOpacity }};\">\n              <sc-for list=\"{{ j.bars }}\" as=\"b\" hint-placeholder-count=\"7\">\n                <span style=\"flex:1;height:{{ b }};background:{{ j.cityColor }};border-radius:4px 4px 0 0;\"></span>\n              </sc-for>\n            </div>\n            <!-- ground -->\n            <div style=\"position:absolute;bottom:0;left:0;right:0;height:30%;background:{{ j.ground }};\"></div>\n            <div style=\"position:absolute;bottom:13%;left:0;right:0;height:3px;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.7) 0 40px,transparent 40px 80px);\"></div>\n            <!-- label -->\n            <div style=\"position:absolute;top:9%;left:7%;max-width:440px;\">\n              <div style=\"display:inline-flex;align-items:center;gap:9px;padding:7px 16px;background:rgba(10,31,24,0.78);border-radius:100px;margin-bottom:18px;\">\n                <span style=\"width:9px;height:9px;border-radius:50%;background:#FBC02D;\"></span>\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1px;color:#fff;text-transform:uppercase;\">Stop {{ j.stop }} · {{ j.time }}</span>\n              </div>\n              <h3 data-route-title=\"\" style=\"font-family:MuseoModerno;font-weight:800;font-size:64px;line-height:0.95;letter-spacing:-2px;color:{{ j.titleColor }};margin:0 0 12px;\">{{ j.name }}</h3>\n              <p style=\"font-family:Urbanist;font-weight:500;font-size:18px;color:{{ j.subColor }};margin:0;max-width:380px;\">{{ j.note }}</p>\n            </div>\n          </div>\n        </sc-for>\n      </div>\n      <!-- single scroll-synced bus, travels the corridor and recolours per scene -->\n      <div ref=\"{{ busRef }}\" style=\"position:absolute;bottom:16%;left:22%;width:150px;height:48px;background:#3CB371;border-radius:8px 20px 6px 6px;box-shadow:0 10px 24px rgba(0,0,0,0.25);z-index:3;transition:background-color .4s ease;\">\n        <div ref=\"{{ busFlipRef }}\" style=\"width:100%;height:100%;position:relative;\">\n          <div ref=\"{{ busBobRef }}\" style=\"width:100%;height:100%;position:relative;\">\n            <div style=\"position:absolute;top:9px;left:14px;display:flex;gap:7px;\"><span style=\"width:20px;height:16px;background:rgba(255,255,255,0.45);border-radius:3px;\"></span><span style=\"width:20px;height:16px;background:rgba(255,255,255,0.45);border-radius:3px;\"></span><span style=\"width:20px;height:16px;background:rgba(255,255,255,0.45);border-radius:3px;\"></span></div>\n          </div>\n        </div>\n      </div>\n      <!-- progress dots -->\n      <div style=\"position:absolute;bottom:34px;left:50%;transform:translateX(-50%);display:flex;gap:10px;z-index:5;\">\n        <sc-for list=\"{{ journeyPanels }}\" as=\"j\" hint-placeholder-count=\"6\">\n          <span style=\"width:8px;height:8px;border-radius:50%;background:rgba(10,31,24,0.3);\"></span>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= SUGGEST A ROUTE ================= -->\n  <section ref=\"{{ suggestRef }}\" style=\"background:#F5E6C8;padding:110px 40px;\">\n    <div style=\"max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:32px;align-items:start;\" data-suggest-grid=\"\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;\">Help us expand</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:42px;line-height:1.05;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 18px;\">Where should TMO go next?</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 26px;max-width:450px;\">TMO grows where commuters need it most. Tell us the route you wish we ran — and let us know whether you'd subscribe and pay for the service once we expand there. Your demand is what guides our next corridor.</p>\n        <div style=\"display:flex;flex-direction:column;gap:14px;\">\n          <div style=\"display:flex;align-items:flex-start;gap:12px;\"><span style=\"flex-shrink:0;width:26px;height:26px;border-radius:8px;background:#0F4C3A;color:#fff;display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:800;font-size:13px;\">1</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.5;color:#2C3A34;\">Name the start and destination you commute most.</span></div>\n          <div style=\"display:flex;align-items:flex-start;gap:12px;\"><span style=\"flex-shrink:0;width:26px;height:26px;border-radius:8px;background:#0F4C3A;color:#fff;display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:800;font-size:13px;\">2</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.5;color:#2C3A34;\">Tell us if you'd pay to subscribe to that route.</span></div>\n          <div style=\"display:flex;align-items:flex-start;gap:12px;\"><span style=\"flex-shrink:0;width:26px;height:26px;border-radius:8px;background:#0F4C3A;color:#fff;display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:800;font-size:13px;\">3</span><span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.5;color:#2C3A34;\">We prioritise the routes with the most committed demand.</span></div>\n        </div>\n      </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showHome }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= FLEET MANAGEMENT ================= -->\n  <section ref=\"{{ fleetRef }}\" data-screen-label=\"Fleet Management\" style=\"background:#F5E6C8;padding:120px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:0.85fr 1.15fr;gap:64px;align-items:center;\" data-dash-grid=\"\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;\">TMO Fleet Management</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:44px;line-height:1.05;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 20px;\">Your whole fleet. One dashboard.</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 30px;\">Own more than one vehicle? Onboard your entire fleet onto TMO and watch every vehicle work. See how many vehicles you have on the road, what type they are, which routes they run, and exactly how much each one is making — or is projected to make — all from one account.</p>\n        <div style=\"display:flex;flex-wrap:wrap;gap:12px;\">\n          <button sc-camel-on-click=\"{{ openFleet }}\" style=\"background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#fff;padding:15px 26px;border-radius:13px;\" style-hover=\"background:#14543B;\">Onboard your fleet</button>\n          <button sc-camel-on-click=\"{{ openLogin }}\" style=\"background:transparent;border:1.5px solid #0F4C3A;cursor:pointer;font-family:Urbanist;font-weight:600;font-size:15px;color:#0F4C3A;padding:14px 24px;border-radius:13px;\" style-hover=\"background:rgba(15,76,58,0.06);\">Login to Fleet Dashboard</button>\n        </div>\n      </div>\n      <div data-reveal=\"\" data-reveal-delay=\"120\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;background:#0A1F18;border-radius:26px;padding:26px;box-shadow:0 40px 80px -30px rgba(10,31,24,0.5);\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;\">\n          <div style=\"display:flex;align-items:center;gap:10px;\">\n            <span style=\"width:36px;height:36px;border-radius:11px;background:#3CB371;display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:800;font-size:15px;color:#0A1F18;\">A</span>\n            <div style=\"display:flex;flex-direction:column;\"><span style=\"font-family:Urbanist;font-weight:600;font-size:14px;color:#fff;\">Adebayo K. · Fleet Owner</span><span style=\"font-family:Urbanist;font-size:11px;color:rgba(255,255,255,0.5);\">12 vehicles on platform</span></div>\n          </div>\n          <span style=\"font-family:Urbanist;font-weight:700;font-size:11px;letter-spacing:1.2px;color:#7FE0AC;border:1px solid rgba(60,179,113,0.45);border-radius:100px;padding:5px 12px;\">TMO FLEET</span>\n        </div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n          <div style=\"background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;\">\n            <span style=\"font-family:Urbanist;font-size:11.5px;color:rgba(255,255,255,0.55);\">VEHICLES</span>\n            <div style=\"font-family:MuseoModerno;font-weight:700;font-size:20px;color:#fff;margin-top:6px;\">12 on platform</div>\n            <div style=\"font-family:Urbanist;font-size:12px;color:#7FE0AC;margin-top:4px;\">6 Buses · 4 Sedans · 2 Vans</div>\n          </div>\n          <div style=\"grid-column:1 / -1;background:linear-gradient(135deg,#1A6349,#0F4C3A);border-radius:16px;padding:20px;\">\n            <div style=\"display:flex;gap:24px;\">\n              <div><span style=\"font-family:Urbanist;font-size:12px;color:rgba(255,255,255,0.6);letter-spacing:1px;\">FLEET EARNINGS · THIS MONTH</span><div style=\"font-family:MuseoModerno;font-weight:800;font-size:30px;color:#fff;margin-top:4px;\">₦2.4M</div></div>\n              <div><span style=\"font-family:Urbanist;font-size:12px;color:rgba(255,255,255,0.6);letter-spacing:1px;\">PROJECTED · NEXT MONTH</span><div style=\"font-family:MuseoModerno;font-weight:800;font-size:30px;color:#FBC02D;margin-top:4px;\">₦2.9M</div></div>\n            </div>\n          </div>\n          <div style=\"grid-column:1 / -1;background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;\">\n            <span style=\"font-family:Urbanist;font-size:11.5px;color:rgba(255,255,255,0.55);\">VEHICLE LIST</span>\n            <div style=\"display:flex;flex-direction:column;gap:10px;margin-top:12px;\">\n              <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;\"><span style=\"font-family:Urbanist;font-size:13px;color:#fff;\">LND-234-KJA · Bus · Ajah → CMS · <span style=\"color:#7FE0AC;\">Active</span></span><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;color:#7FE0AC;\">₦310k</span></div>\n              <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;\"><span style=\"font-family:Urbanist;font-size:13px;color:#fff;\">EKY-102-AAA · Sedan · Sangotedo → VI · <span style=\"color:#7FE0AC;\">Active</span></span><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;color:#7FE0AC;\">₦185k</span></div>\n              <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;\"><span style=\"font-family:Urbanist;font-size:13px;color:#fff;\">MUS-556-LSD · Van · Island ↔ Mainland · <span style=\"color:#7FE0AC;\">Active</span></span><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;color:#7FE0AC;\">₦240k</span></div>\n              <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;\"><span style=\"font-family:Urbanist;font-size:13px;color:#fff;\">KTU-889-EPE · Bus · Lekki → CMS · <span style=\"color:rgba(255,255,255,0.45);\">Idle</span></span><span style=\"font-family:Urbanist;font-weight:600;font-size:13px;color:rgba(255,255,255,0.45);\">₦0 today · proj. ₦280k</span></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showLeadership }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= LEADERSHIP ================= -->\n  <section ref=\"{{ leadershipRef }}\" style=\"background:#0A1F18;padding:120px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;max-width:620px;margin-bottom:56px;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">Leadership &amp; Team</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.04;letter-spacing:-1.5px;color:#fff;margin:16px 0 18px;\">The people behind TMO.</h2>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.6;color:rgba(255,255,255,0.6);margin:0;\">CMS&nbsp;T&amp;M is governed by a Board representing seven cooperative groups across Lagos.</p>\n      </div>\n\n      <!-- featured: Andy Akhigbe -->\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;display:grid;grid-template-columns:0.8fr 1.2fr;gap:44px;align-items:center;background:linear-gradient(135deg,#0F4C3A,#08160F);border:1px solid rgba(60,179,113,0.32);border-radius:26px;padding:44px;margin-bottom:52px;\" data-andy-grid=\"\">\n        <div style=\"position:relative;border-radius:20px;overflow:hidden;aspect-ratio:0.9;background:linear-gradient(135deg,#3CB371,#0F4C3A);box-shadow:0 30px 60px -24px rgba(0,0,0,0.6);\">\n          <img src=\"https://raw.githubusercontent.com/marshalsoft/cms-tm-website/1faaccca49dfa579be2fbfeed918011a53963373/images/ANDY-AKHIGBE.jpeg\" alt=\"Andy Akhigbe\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\">\n        </div>\n        <div>\n          <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1.5px;color:#FBC02D;text-transform:uppercase;\">MD/CEO · CMS&nbsp;T&amp;M</span>\n          <h3 style=\"font-family:MuseoModerno;font-weight:800;font-size:36px;letter-spacing:-1px;color:#fff;margin:10px 0 18px;\">Andy Akhigbe</h3>\n          <p style=\"font-family:Urbanist;font-size:15.5px;line-height:1.7;color:rgba(255,255,255,0.8);margin:0 0 14px;\">Andy is the MD/CEO of CMS Taxi &amp; Motor Nigeria Limited, a public transportation company based in Lagos. He attended Harvard University Graduate School of Education (HGSE) Project Zero Classroom from 2007–2009, and spent 21 years at First Bank, resigning voluntarily on June 6, 2014 as a Business Manager. CMS&nbsp;T&amp;M was an account under his management at First Bank — where he was first exposed to the company's operations — and he joined the company in 2016.</p>\n          <p style=\"font-family:Urbanist;font-size:15.5px;line-height:1.7;color:rgba(255,255,255,0.72);margin:0 0 22px;\">At First Bank he packaged credit requests and managed A-list companies including Dangote's Obajana Cement Factory and AA Rano Petroleum, alongside high-net-worth relationships such as Tom Dim Limited — where he packaged the ₦350M purchase of a 100-bed hotel facility in Apapa. Post-retirement he founded LearnPower, an ed-tech platform for primary, secondary and tertiary learners across Nigeria, and served as a Director at TenStrings, Nigeria's largest and most successful music institute.</p>\n          <div style=\"display:flex;flex-wrap:wrap;gap:9px;\">\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;color:rgba(255,255,255,0.85);border:1px solid rgba(60,179,113,0.35);border-radius:100px;padding:7px 15px;\">Harvard HGSE · PZC '07–'09</span>\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;color:rgba(255,255,255,0.85);border:1px solid rgba(60,179,113,0.35);border-radius:100px;padding:7px 15px;\">21 Years · First Bank</span>\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;color:rgba(255,255,255,0.85);border:1px solid rgba(60,179,113,0.35);border-radius:100px;padding:7px 15px;\">Founder · LearnPower</span>\n            <span style=\"font-family:Urbanist;font-weight:600;font-size:12.5px;color:rgba(255,255,255,0.85);border:1px solid rgba(60,179,113,0.35);border-radius:100px;padding:7px 15px;\">Director · TenStrings</span>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:18px;\" data-leaders-grid=\"\">\n        <sc-for list=\"{{ leaders }}\" as=\"l\" hint-placeholder-count=\"8\">\n          <div sc-camel-on-mouse-enter=\"{{ l.enter }}\" sc-camel-on-mouse-leave=\"{{ leave }}\" data-reveal=\"\" style=\"position:relative;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;background:#0F4C3A;border:1px solid rgba(60,179,113,0.22);border-radius:18px;padding:24px;cursor:pointer;\" style-hover=\"border-color:rgba(60,179,113,0.6);\">\n            <sc-if value=\"{{ l.hovered }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"position:absolute;left:50%;bottom:calc(100% - 26px);width:210px;z-index:30;pointer-events:none;animation:popIn .26s cubic-bezier(.16,1,.3,1) both;\">\n                <div style=\"border-radius:18px;overflow:hidden;background:#08160F;border:1px solid rgba(60,179,113,0.55);box-shadow:0 34px 70px -22px rgba(0,0,0,0.8);\">\n                  {{ l.popupImg }}\n                  <div style=\"padding:12px 14px;\">\n                    <div style=\"font-family:MuseoModerno;font-weight:700;font-size:15px;color:#fff;\">{{ l.name }}</div>\n                    <div style=\"font-family:Urbanist;font-size:12px;color:#7FE0AC;margin-top:2px;\">{{ l.role }}</div>\n                  </div>\n                </div>\n                <div style=\"width:14px;height:14px;background:#08160F;border-right:1px solid rgba(60,179,113,0.55);border-bottom:1px solid rgba(60,179,113,0.55);transform:rotate(45deg);margin:-7px auto 0;\"></div>\n              </div>\n            </sc-if>\n            <div style=\"position:relative;width:64px;height:64px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,{{ l.c1 }},{{ l.c2 }});display:flex;align-items:center;justify-content:center;font-family:MuseoModerno;font-weight:700;font-size:22px;color:#fff;margin-bottom:18px;\">\n              <sc-if value=\"{{ l.noPhoto }}\" hint-placeholder-val=\"{{ true }}\">{{ l.initials }}</sc-if>\n              <sc-if value=\"{{ l.hasPhoto }}\" hint-placeholder-val=\"{{ false }}\">{{ l.avatarImg }}</sc-if>\n            </div>\n            <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:18px;color:#fff;margin:0 0 5px;line-height:1.15;\">{{ l.name }}</h3>\n            <p style=\"font-family:Urbanist;font-size:13.5px;line-height:1.45;color:rgba(255,255,255,0.6);margin:0;\">{{ l.role }}</p>\n          </div>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showBlog }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= BLOG ================= -->\n  <header style=\"position:relative;background:radial-gradient(120% 90% at 70% 10%,#15573F 0%,#0F4C3A 45%,#0A2A1F 100%);padding:150px 40px 90px;overflow:hidden;\">\n    <div style=\"position:absolute;top:-120px;right:-80px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(60,179,113,0.24),transparent 65%);filter:blur(20px);\"></div>\n    <div style=\"position:relative;max-width:1100px;margin:0 auto;text-align:center;\">\n      <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">TMO Newsroom</span>\n      <h1 style=\"font-family:MuseoModerno;font-weight:800;font-size:58px;line-height:1.02;letter-spacing:-2px;color:#fff;margin:18px auto 16px;max-width:760px;\">Stories from the corridor.</h1>\n      <p style=\"font-family:Urbanist;font-size:18px;line-height:1.6;color:rgba(255,255,255,0.72);max-width:560px;margin:0 auto;\">News, milestones, and the story of how CMS&nbsp;T&amp;M and cmstaxiandmotor are digitising public transport in Lagos.</p>\n    </div>\n  </header>\n\n  <section style=\"background:#FFFFFF;padding:90px 40px 110px;\">\n    <div style=\"max-width:1100px;margin:0 auto;\">\n      <!-- featured story -->\n      <a href=\"#blog\"  rel=\"noopener\" style=\"display:block;text-decoration:none;border-radius:26px;overflow:hidden;border:1px solid #ECE7DA;box-shadow:0 34px 80px -40px rgba(10,31,24,0.45);margin-bottom:64px;\" data-blog-feature=\"\">\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch;\" data-blog-grid=\"\">\n          <div style=\"position:relative;min-height:340px;background:linear-gradient(180deg,rgba(10,42,31,0.25) 0%,rgba(10,42,31,0.55) 55%,rgba(10,31,24,0.92) 100%),url(&quot;8a89c375-d078-42bc-a3b4-8231485c591d&quot;);background-size:cover;background-position:center;display:flex;flex-direction:column;justify-content:flex-end;padding:40px;\">\n            <div style=\"position:absolute;top:36px;left:40px;display:inline-flex;align-items:center;gap:10px;\">\n              <img src=\"1c78ab4d-94d9-4159-99c0-9b82bd6b23d9\" alt=\"cmstaxiandmotor\" style=\"height:24px;width:auto;\">\n              <span style=\"font-family:Urbanist;font-weight:700;font-size:12px;color:rgba(255,255,255,0.7);\">×</span>\n              <img src=\"820573a8-f9db-4517-911c-b3d75a01cb1c\" alt=\"CMS T&amp;M\" style=\"height:30px;width:auto;\">\n            </div>\n            <span style=\"display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:7px 15px;background:#FBC02D;border-radius:100px;margin-bottom:16px;font-family:Urbanist;font-weight:700;font-size:11.5px;letter-spacing:1px;color:#0A1F18;text-transform:uppercase;\">Featured · The Partnership</span>\n            <h2 style=\"font-family:MuseoModerno;font-weight:800;font-size:34px;line-height:1.08;letter-spacing:-1px;color:#fff;margin:0;\">cmstaxiandmotor partners with CMS&nbsp;T&amp;M to digitise transport for 1.2 million riders a year.</h2>\n          </div>\n          <div style=\"background:#fff;padding:44px;display:flex;flex-direction:column;justify-content:center;\">\n            <span style=\"font-family:Urbanist;font-weight:700;font-size:12.5px;letter-spacing:1px;color:#3CB371;text-transform:uppercase;margin-bottom:14px;\">Partnership · 2021</span>\n            <p style=\"font-family:Urbanist;font-size:16px;line-height:1.7;color:#2C3A34;margin:0 0 14px;\">In a landmark move for Lagos mobility, Canadian-born mobility-tech company cmstaxiandmotor (formerly Plentywaka) took a <strong style=\"color:#0F4C3A;\">10% equity stake in CMS&nbsp;T&amp;M in 2021</strong> — bringing modern technology to one of Nigeria's oldest and most structured transport institutions, and setting out to digitise the journeys of the <strong style=\"color:#0F4C3A;\">1.2 million+ passengers</strong> who ride the corridor every year.</p>\n            <p style=\"font-family:Urbanist;font-size:16px;line-height:1.7;color:#41514A;margin:0 0 14px;\">CMS&nbsp;T&amp;M has run the Central Business District of Lagos — Marina, Lagos Island, Victoria Island, Ikoyi and the Lekki–Ajah corridor — for nearly six decades. cmstaxiandmotor added the software layer: cashless ticketing, digital payments, predictable travel times, and the operations-management system that powers the TMO platform today.</p>\n            <p style=\"font-family:Urbanist;font-size:16px;line-height:1.7;color:#41514A;margin:0 0 22px;\">For commuters it means structure and reliability — tap-to-pay cards, regulated fares, and live routes. For the seven cooperative groups behind CMS&nbsp;T&amp;M, it means better tools, transparent earnings, and a path to grow. It is a model of how a heritage institution and a technology partner can move a city forward together.</p>\n           \n          </div>\n        </div>\n      </a>\n\n      <h3 style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;margin:0 0 24px;\">More from TMO &amp; CMS</h3>\n      <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:22px;\" data-blogcards-grid=\"\">\n        <sc-for list=\"{{ blogPosts }}\" as=\"b\" hint-placeholder-count=\"4\">\n          <a href=\"#blog\" rel=\"noopener\" style=\"display:block;text-decoration:none;background:#FFFFFF;border:1px solid #ECE7DA;border-radius:20px;overflow:hidden;box-shadow:0 18px 44px -30px rgba(10,31,24,0.35);\" style-hover=\"border-color:#3CB371;\">\n            <div style=\"height:8px;background:{{ b.bar }};\"></div>\n            <div style=\"padding:28px 28px 30px;\">\n              <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:14px;\">\n                <span style=\"font-family:Urbanist;font-weight:700;font-size:11.5px;letter-spacing:0.8px;color:#0F4C3A;background:#F0F7F3;border-radius:100px;padding:6px 13px;text-transform:uppercase;\">{{ b.tag }}</span>\n                <span style=\"font-family:Urbanist;font-size:13px;color:#9AA8A1;\">{{ b.date }}</span>\n              </div>\n              <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:22px;line-height:1.18;letter-spacing:-0.5px;color:#0F4C3A;margin:0 0 10px;\">{{ b.title }}</h4>\n              <p style=\"font-family:Urbanist;font-size:15px;line-height:1.6;color:#5B6B63;margin:0 0 18px;\">{{ b.excerpt }}</p>\n              \n            </div>\n          </a>\n        </sc-for>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showAbout }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= COOPERATIVE MODEL ================= -->\n  <section style=\"background:#F5E6C8;padding:120px 40px;\">\n    <div style=\"max-width:1100px;margin:0 auto;\">\n      <div style=\"max-width:780px;margin:0 auto 14px;text-align:center;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#C99A1E;text-transform:uppercase;\">The Cooperative Model</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:44px;line-height:1.06;letter-spacing:-1.5px;color:#0F4C3A;margin:16px 0 0;\">Strength in structure. Resilience in numbers.</h2>\n      </div>\n      <div style=\"max-width:800px;margin:0 auto 60px;text-align:center;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#41514A;margin:0 0 16px;\">One enduring benefit of running public transport on a cooperative model is that it reduces the risk of failure. CMS&nbsp;T&amp;M organises itself around independent transport groups — each with its own leaders, members, and governance — all submitting to the limited liability company known today as CMS&nbsp;T&amp;M.</p>\n        <p style=\"font-family:Urbanist;font-size:17px;line-height:1.7;color:#0F4C3A;font-weight:600;margin:0;\">There are seven Directors in CMS&nbsp;T&amp;M — each the head of their respective cooperative group.</p>\n      </div>\n\n      <h3 style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;text-align:center;margin:0 0 26px;\">The Seven Cooperatives</h3>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:72px;\" data-coop-groups=\"\">\n        <sc-for list=\"{{ coopGroups }}\" as=\"g\" hint-placeholder-count=\"7\">\n          <div style=\"background:#FFFFFF;border:1px solid #ECE3CE;border-radius:18px;padding:26px 24px;animation:revealIn .8s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 46%;\" style-hover=\"border-color:#3CB371;\">\n            <span style=\"display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:11px;background:#F0F7F3;color:#0F4C3A;font-family:MuseoModerno;font-weight:800;font-size:14px;margin-bottom:16px;\">{{ g.n }}</span>\n            <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:19px;line-height:1.2;color:#0F4C3A;margin:0 0 8px;\">{{ g.name }}</h4>\n            <p style=\"font-family:Urbanist;font-size:14.5px;line-height:1.55;color:#5B6B63;margin:0;\">{{ g.desc }}</p>\n          </div>\n        </sc-for>\n      </div>\n\n      <div style=\"text-align:center;margin:0 0 64px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 46%;\">\n        <button sc-camel-on-click=\"{{ goLeadership }}\" style=\"display:inline-flex;align-items:center;gap:9px;background:#0F4C3A;border:none;cursor:pointer;font-family:Urbanist;font-weight:700;font-size:15px;color:#fff;padding:15px 28px;border-radius:13px;\" style-hover=\"background:#14543B;\">Meet the seven Directors &amp; leadership <span style=\"font-size:17px;\">→</span></button>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:0.85fr 1.15fr;gap:48px;align-items:center;background:#0A1F18;border-radius:24px;padding:48px;margin-bottom:72px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\" data-coop-adv=\"\">\n        <div>\n          <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">Why it works</span>\n          <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:32px;line-height:1.1;letter-spacing:-1px;color:#fff;margin:14px 0 0;\">Advantages that outweigh the trade-offs.</h3>\n        </div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:24px;\">\n          <sc-for list=\"{{ coopAdvantages }}\" as=\"a\" hint-placeholder-count=\"4\">\n            <div>\n              <span style=\"font-family:MuseoModerno;font-weight:800;font-size:24px;color:#FBC02D;display:block;margin-bottom:8px;\">{{ a.n }}</span>\n              <p style=\"font-family:Urbanist;font-size:15px;line-height:1.55;color:rgba(255,255,255,0.78);margin:0;\">{{ a.t }}</p>\n            </div>\n          </sc-for>\n        </div>\n      </div>\n\n      <div style=\"text-align:center;max-width:680px;margin:0 auto 30px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#3CB371;text-transform:uppercase;\">Recognised by the ILO</span>\n        <h3 style=\"font-family:MuseoModerno;font-weight:700;font-size:30px;line-height:1.12;letter-spacing:-1px;color:#0F4C3A;margin:14px 0 0;\">In tandem with the principles of cooperative societies.</h3>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:28px;\" data-ilo-grid=\"\">\n        <sc-for list=\"{{ iloBenefits }}\" as=\"b\" hint-placeholder-count=\"5\">\n          <div style=\"background:#FFFFFF;border:1px solid #ECE3CE;border-radius:18px;padding:26px 24px;animation:revealIn .8s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 46%;\">\n            <div style=\"width:34px;height:4px;border-radius:4px;background:#FBC02D;margin-bottom:18px;\"></div>\n            <h4 style=\"font-family:MuseoModerno;font-weight:700;font-size:18px;line-height:1.2;color:#0F4C3A;margin:0 0 8px;\">{{ b.t }}</h4>\n            <p style=\"font-family:Urbanist;font-size:14.5px;line-height:1.55;color:#5B6B63;margin:0;\">{{ b.d }}</p>\n          </div>\n        </sc-for>\n      </div>\n      <div style=\"display:flex;align-items:flex-start;gap:14px;background:#F0F7F3;border:1px solid #D9EBE1;border-left:4px solid #3CB371;border-radius:14px;padding:20px 24px;animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-size:15.5px;line-height:1.6;color:#2C3A34;margin:0;\">Under <strong style=\"color:#0F4C3A;\">ILO Recommendation No.&nbsp;193</strong>, a transport cooperative like CMS&nbsp;T&amp;M is recognised for its resilience and its ability to address poverty.</span>\n      </div>\n    </div>\n  </section>\n\n  </sc-if>\n\n  <sc-if value=\"{{ showHome }}\" hint-placeholder-val=\"{{ false }}\">\n  <!-- ================= CONTACT ================= -->\n  <section ref=\"{{ contactRef }}\" style=\"background:radial-gradient(120% 100% at 70% 0%,#15573F,#0F4C3A 60%,#0A2A1F);padding:120px 40px;\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:32px;\" data-contact-grid=\"\">\n      <div data-reveal=\"\" style=\"animation:revealIn .85s cubic-bezier(.16,1,.3,1) both;animation-timeline:view();animation-range:entry 0% entry 42%;\">\n        <span style=\"font-family:Urbanist;font-weight:700;font-size:13px;letter-spacing:1.5px;color:#7FE0AC;text-transform:uppercase;\">Let's Talk</span>\n        <h2 style=\"font-family:MuseoModerno;font-weight:700;font-size:46px;line-height:1.04;letter-spacing:-1.5px;color:#fff;margin:16px 0 30px;\">Contact Us</h2>\n        <div style=\"display:flex;flex-direction:column;gap:22px;\">\n          <div style=\"display:flex;gap:14px;align-items:flex-start;\"><span style=\"font-size: 20px;\">📍</span><span style=\"font-family: Urbanist; font-size: 16px; line-height: 1.5; color: rgba(255, 255, 255, 0.82);\">CMS Taxi &amp; Motor Nigeria Limited<br>Car Park 4<br>Opposite the Cathedral Church, Marina<br>Lagos, Nigeria</span></div>\n          <div style=\"display:flex;gap:14px;align-items:center;\"><span style=\"font-size:20px;\">📞</span><span style=\"font-family:Urbanist;font-size:16px;color:rgba(255,255,255,0.82);\"><p data-pm-slice=\"1 1 []\">+234 814 046 7195</p></span></div>\n          <div style=\"display:flex;gap:14px;align-items:center;\"><span style=\"font-size:20px;\">✉️</span><a href=\"mailto:info@cmstnm.com\" style=\"font-family:Urbanist;font-size:16px;color:rgba(255,255,255,0.82);text-decoration:none;\">info@cmstnm.com</a></div>\n          <div style=\"display:flex;gap:12px;margin-top:6px;\">\n            <a href=\"https://